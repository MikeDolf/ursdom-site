{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block body %}
<section class="d-hero"><div class="wrap">
  <h1>{{ h1 }}</h1>
  <p>{{ hero_sub }}</p>
  <div class="d-cta-row">
    <a class="d-btn d-btn-max" href="{{ cfg.max_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">Написать в MAX</a>
    <a class="d-btn d-btn-ghost" href="#zayavka">Узнать цену с доставкой</a>
  </div>
</div></section>

<section><div class="wrap d-prose">
  <div class="d-tldr"><strong>Коротко по доставке {{ place.prep }}</strong><p>{{ lead }}</p></div>

{% for s in sections %}
  <h2 id="{{ s.id }}">{{ s.h }}</h2>
{{ m.blocks(s) }}
{% if loop.index == cta_after %}{{ m.midcta(cfg, cta_head, cta_text) }}{% endif %}
{% endfor %}
</div></section>

<section><div class="wrap">
  <h2>Ориентировочные цены на материалы {{ place.loc }}</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ price_note }} Итоговая цена с доставкой {{ place.prep }} зависит от расстояния ({{ place.dist }}) и объёма машины.</caption>
    <thead><tr><th>Материал</th><th>Цена за куб, руб</th></tr></thead>
    <tbody>
{% for name,price in per_cube %}      <tr><td>{{ name }}</td><td>{{ price }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
  <p class="d-note">{{ delivery_note }}</p>
</div></section>

<section id="zayavka"><div class="wrap d-two">
  <div>{{ m.callblock(cfg) }}</div>
  <div>
    <h2>Заявка на доставку {{ place.prep }}</h2>
    {{ m.lead_form(cfg, subject) }}
  </div>
</div></section>

<section><div class="wrap">
  <h2>Частые вопросы о доставке {{ place.prep }}</h2>
  {{ m.faq(faq) }}
</div></section>

<section><div class="wrap">
  {{ m.related(related_links) }}
</div></section>
{% endblock %}
