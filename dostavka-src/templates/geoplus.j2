{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{# Порядок блоков по просьбе владельца: зашёл, увидел цену, посчитал,
   оставил заявку. Поэтому сразу за первым экраном «сколько стоит
   машина», калькулятор и форма, а фото доставок, гарантии, текст,
   прайс, города и частые вопросы ниже. #}
{% block fleet %}{% endblock %}
{% block body %}
{{ m.hero2(h1, hero_sub, bg=hero_bg, price=hero_price,
           price_unit="руб за куб, доставка " ~ place.prep ~ " по плечу " ~ plecho_km ~ " км",
           note="Оплата после выгрузки, объём проверяете по кузову до разгрузки", cfg=cfg, third_href=("#kalkulyator" if calc else "#zayavka"), third_text=("Посчитать в калькуляторе" if calc else "Узнать цену с доставкой")) }}

{% if lots %}
<section class="d-band"><div class="wrap">
  {{ m.sh("Сколько стоит машина " ~ place.prep, "skolko-mashina", price_lead) }}
  <div class="d-lotcards">
{% for r in lots %}    <div class="d-lotcard">
      <span class="d-lotcard-vol">{{ r.vol }} м³</span>
      <b>{{ r.total }} <small>руб</small></b>
      <span>{{ r.truck }}: материал {{ r.material }} руб и доставка {{ r.delivery }} руб</span>
    </div>
{% endfor %}  </div>
  <p class="d-note">Предварительный расчёт для плеча {{ plecho_km }} км, точную сумму называем по заявке.
  {{ lots_note }} Другой объём посчитает
  <a href="/dostavka/kalkulyator/{{ calc_slug|default('pesok', true) }}/">калькулятор {{ calc_rod|default('песка', true) }}</a>,
  там же объём по размерам площадки и перевод кубов в тонны.</p>
</div></section>
{% endif %}

{% if calc %}<section class="d-band d-band-tint"><div class="wrap">
{{ m.calculator(cfg, calc) }}
</div></section>
{% endif %}

{{ m.form_band(cfg, "Заявка на доставку " ~ place.prep, subject) }}

{{ m.deliveries(fleet_photos) }}

{{ m.guarantee_band(g.guarantees, g.trust) }}

{{ m.why_band(g.why, g.stats, cfg) }}

{% set order = sections|selectattr("id", "equalto", "kak-zakazat")|first %}
{% if order %}{{ m.steps_band(order.h, order.steps) }}{% endif %}

{% if info %}<section class="d-band"><div class="wrap">
  {{ m.sh("Доставка " ~ place.prep, "dostavka") }}
  {{ m.info_cards(info, info_note) }}
</div></section>
{% endif %}

{{ m.trucks(trucks) }}

<section class="d-band"><div class="wrap d-prose">
{% for s in sections if s.id not in ("kak-zakazat", "kuda") %}
  <h2 class="d-sh" id="{{ s.id }}">{{ s.h }}</h2>
{{ m.blocks(s) }}
{% endfor %}
</div></section>

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.sh("Цены на все материалы " ~ place.loc, "ceny") }}
  <div class="d-table-wrap"><table{% if per_cube_trip %} class="d-trip"{% endif %}>
    <caption>{{ price_note }} Итоговая цена с доставкой {{ place.prep }} зависит от расстояния ({{ place.dist }}) и объёма машины.{% if per_cube_trip %} Последний столбец: предварительная сумма за машину на {{ trip_vol }} м³ с доставкой {{ place.prep }}.{% endif %}</caption>
{% if per_cube_trip %}    <thead><tr><th>Материал</th><th>За куб, руб</th><th>{{ trip_vol }} м³ с доставкой, руб</th></tr></thead>
    <tbody>
{% for name,price,trip in per_cube_trip %}      <tr><td>{{ name }}</td><td>{{ price }}</td><td class="d-spec-val">{{ trip }}</td></tr>
{% endfor %}    </tbody>
{% else %}    <thead><tr><th>Материал</th><th>Цена за куб, руб</th></tr></thead>
    <tbody>
{% for name,price in per_cube %}      <tr><td>{{ name }}</td><td>{{ price }}</td></tr>
{% endfor %}    </tbody>
{% endif %}
  </table></div>
  <p class="d-note">{{ delivery_note }}</p>
</div></section>

<section class="d-band"><div class="wrap">
  {{ m.chips(related_links, "Ещё по теме и в соседних городах") }}
</div></section>

{{ m.msg_card(cfg) }}

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.sh("Частые вопросы о доставке " ~ place.prep, "faq") }}
  {{ m.faq(faq) }}
</div></section>
{% endblock %}
