{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block body %}
<section class="d-hero"><div class="wrap">
  <h1>{{ h1 }}</h1>
  <p>Щебень, песок и нерудные материалы с доставкой по {{ cfg.region_dat }}. Самосвалы от 5 до 20 кубов, оплата после выгрузки, {{ cfg.callback_promise }}.</p>
  <div class="d-cta-row">
    <a class="d-btn" href="{{ cfg.phone_href }}" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','call')}catch(e){}">Позвонить {{ cfg.phone }}</a>
    <a class="d-btn d-btn-ghost" href="#zayavka">Оставить заявку</a>
  </div>
</div></section>

<section><div class="wrap">
  <h2>Что возим и сколько стоит</h2>
  <div class="d-cat">
{% for name,price,href,desc in catalog %}    <div class="d-cat-card">
      <p class="d-cat-name">{% if href %}<a href="{{ href }}">{{ name }}</a>{% else %}{{ name }}{% endif %}</p>
      <p class="d-cat-price">{{ price }} <small>руб/м³</small></p>
      <p>{{ desc }}</p>
{% if href %}      <p class="d-cat-go">Подробнее и заказать</p>
{% endif %}    </div>
{% endfor %}  </div>
  <p class="d-note">{{ price_note }}</p>
</div></section>

<section class="d-dark-sec"><div class="wrap">
  <h2>Почему заказывают у нас</h2>
  {{ m.advantages(advantages) }}
</div></section>

<section><div class="wrap">
  <h2>Доставка по городам области</h2>
  <p>Возим в Екатеринбург и города Свердловской области. Выберите свой, чтобы узнать сроки и особенности доставки.</p>
  <ul class="d-list">
{% for c in cities %}    <li><a href="/dostavka/shcheben/{{ c.slug }}/">Доставка щебня {{ c.prep }}</a></li>
{% endfor %}  </ul>
</div></section>

<section><div class="wrap">
  <h2>Ориентировочные цены</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ price_note }}</caption>
    <thead><tr><th>Материал</th><th>Цена за куб, руб</th></tr></thead>
    <tbody>
{% for name,price in per_cube %}      <tr><td>{{ name }}</td><td>{{ price }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
  <p class="d-note">{{ delivery_note }}</p>
</div></section>

<section id="zayavka"><div class="wrap d-two">
  <div>{{ m.callblock(cfg) }}</div>
  <div>
    <h2>Заявка на доставку</h2>
    {{ m.lead_form(cfg, "доставка материалов, "+cfg.region_short) }}
  </div>
</div></section>

<section><div class="wrap">
  <h2>Наши гарантии</h2>
  {{ m.guarantees(guarantees) }}
</div></section>

<section><div class="wrap">
  <h2>Частые вопросы</h2>
  {{ m.faq(faq) }}
</div></section>

<section><div class="wrap">
  {{ m.related(related_links) }}
</div></section>
{% endblock %}
