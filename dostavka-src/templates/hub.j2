{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block body %}
<section class="d-hero" style="--cell:{{ hero_cell|default(34) }}px"><div class="wrap">
  <h1>{{ h1 }}</h1>
  <p>Щебень, песок и нерудные материалы с доставкой по {{ cfg.region_dat }}. Самосвалы от 5 до 20 кубов, оплата после выгрузки, {{ cfg.callback_promise }}.</p>
  {{ m.channels(cfg, "#zayavka", "Оставить заявку") }}
  {{ m.sieve(sieve) }}
</div></section>

<section><div class="wrap">
  <h2>Что возим и сколько стоит</h2>
  <div class="d-cat">
{% for name,price,href,desc in catalog %}    <div class="d-cat-card">
      <p class="d-cat-name">{% if href %}<a href="{{ href }}">{{ name }}</a>{% else %}{{ name }}{% endif %}</p>
      <p class="d-cat-price">{{ price }}{% if price != "по запросу" %} <small>руб/м³</small>{% endif %}</p>
      <p>{{ desc }}</p>
{% if href %}      <p class="d-cat-go">Подробнее и заказать</p>
{% endif %}    </div>
{% endfor %}  </div>
  <p class="d-note">{{ price_note }}</p>
</div></section>

<section class="d-dark-sec"><div class="wrap">
  <h2>Почему заказывают у нас</h2>
  {{ m.advantages(advantages) }}
</div></section>

<section><div class="wrap">
  <h2 id="goroda">Доставка по городам Свердловской области</h2>
  <p>Возим в Екатеринбург и {{ cities|length }} городов области, от ближнего пояса до севера.
  Выберите свой: на странице города цены, сроки, плечо доставки и разобранный расчёт объёма.</p>
  <div class="d-table-wrap"><table>
    <caption>Города, куда возим, и материалы по каждому</caption>
    <thead><tr><th>Город</th><th>Плечо от Екатеринбурга</th><th>Что возим</th></tr></thead>
    <tbody>
{% for c in cities %}      <tr><td><a href="/dostavka/shcheben/{{ c.slug }}/">Доставка {{ c.prep }}</a></td><td>{{ c.km }} км</td><td>{{ c.mats }}</td></tr>
{% endfor %}    </tbody>
  </table></div>

  <h2 id="vse-materialy">Все материалы, которые возим</h2>
  <ul class="d-list">
    <li><a href="/dostavka/shcheben/">Щебень: гранитный, известняковый, гравийный, вторичный</a></li>
    <li><a href="/dostavka/pesok/">Песок: карьерный и речной мытый</a></li>
    <li><a href="/dostavka/otsev/">Отсев 0-5</a></li>
    <li><a href="/dostavka/pgs/">ПГС и ОПГС</a></li>
{% for href,name in more_materials %}    <li><a href="{{ href }}">{{ name }}</a></li>
{% endfor %}  </ul>
</div></section>

{# Тот же прайс витриной, что и на товарных страницах. Раньше здесь
   стояла таблица «материал - цена», а на товарной уже витрина:
   один и тот же прайс выглядел на двух страницах по-разному, и это
   читалось как две разные цены. #}
<section><div class="wrap">
  {{ m.shelf(shelf_rows, "Ориентировочные цены", price_note) }}
  <p class="d-note">{{ delivery_note }}</p>
</div></section>

<section><div class="wrap">
  <h2 id="oplata">Как можно заплатить</h2>
  {{ m.payways(payment) }}
</div></section>

<section id="zayavka"><div class="wrap">
  <h2>Оставить заявку</h2>
  <div class="d-two">
  <div>{{ m.callblock(cfg) }}</div>
  <div>
    <h3>Заявка на доставку</h3>
    {{ m.lead_form(cfg, "доставка материалов, "+cfg.region_short) }}
  </div>
  </div>
</div></section>

<section><div class="wrap">
  <h2>Наши гарантии</h2>
  {{ m.guarantees(guarantees) }}
</div></section>

<section><div class="wrap">
  <h2>Частые вопросы</h2>
  {{ m.faq(faq) }}
</div></section>

<section><div class="wrap">
  {{ m.related(related_links) }}
</div></section>
{% endblock %}
