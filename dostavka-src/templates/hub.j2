{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{# Главная раздела по образцу владельца. Стопка фракций с ценами
   остаётся в первом экране: это прайс, который виден сразу, до
   прокрутки, и ради него сюда приходят. #}
{% block fleet %}{% endblock %}
{% block body %}
{% call m.hero2(h1, "Щебень, песок, отсев, ПГС, бетон и ЖБИ с двух площадок отгрузки: в Екатеринбурге и у Верхней Пышмы. Самосвалы от 5 до 20 кубов, цену с доставкой называем по адресу, оплата после выгрузки, " ~ cfg.callback_promise ~ ".", bg=hero_bg_default, cfg=cfg) %}
  {{ m.sieve(sieve) }}
{% endcall %}

<section class="d-band"><div class="wrap">
  {{ m.sh("Что возим и сколько стоит", "chto-vozim") }}
  <div class="d-cat">
{% for name,price,href,desc in catalog %}    <div class="d-cat-card">
      <p class="d-cat-name">{% if href %}<a href="{{ href }}">{{ name }}</a>{% else %}{{ name }}{% endif %}</p>
      <p class="d-cat-price">{{ price }}{% if price != "по запросу" %} <small>руб/м³</small>{% endif %}</p>
      <p>{{ desc }}</p>
{% if href %}      <p class="d-cat-go">Подробнее и заказать</p>
{% endif %}    </div>
{% endfor %}  </div>
  <p class="d-note">{{ price_note }}</p>
</div></section>

{{ m.deliveries(fleet_photos) }}

{{ m.quick_band(cfg, "Посчитаем объём и цену за 15 минут", "Назовите материал, задачу и адрес: подберём фракцию и машину под ваш заезд и назовём итоговую сумму с доставкой.", "доставка материалов, " ~ cfg.region_short) }}

{{ m.guarantee_band(g.guarantees, g.trust) }}

{{ m.why_band(g.why, g.stats, cfg) }}

{{ m.steps_band("Как заказать доставку", [
    "Скажите материал и объём в кубах. Не знаете объём: назовите размеры площадки, посчитаем сами.",
    "Назовите адрес и опишите заезд: ширина ворот, где развернуться и поднять кузов.",
    "Получите точную цену с доставкой. " ~ cfg.callback_promise|capitalize ~ ", на месте сумма не меняется.",
    "Принимаете машину на объекте и проверяете объём. " ~ cfg.payment]) }}

{{ m.form_band(cfg, "Заявка на доставку", "доставка материалов, " ~ cfg.region_short) }}

{{ m.msg_card(cfg) }}

<section class="d-band"><div class="wrap">
  {{ m.sh("Доставка по городам Свердловской области", "goroda",
          "Возим в Екатеринбург и " ~ cities|length ~ " городов области. На странице города цены, сроки, плечо доставки и разобранный расчёт объёма.") }}
  <div class="d-table-wrap"><table>
    <caption>Города, куда возим, и материалы по каждому</caption>
    <thead><tr><th>Город</th><th>Плечо от площадки</th><th>Что возим</th></tr></thead>
    <tbody>
{% for c in cities %}      <tr><td><a href="/dostavka/shcheben/{{ c.slug }}/">Доставка {{ c.prep }}</a></td><td>{{ c.km }} км</td><td>{{ c.mats }}</td></tr>
{% endfor %}    </tbody>
  </table></div>

  {{ m.chips([("/dostavka/shcheben/", "Щебень: гранитный, известняковый, гравийный, вторичный"),
              ("/dostavka/pesok/", "Песок: карьерный и речной мытый"),
              ("/dostavka/otsev/", "Отсев 0-5"),
              ("/dostavka/pgs/", "ПГС и ОПГС")] + more_materials, "Все материалы, которые возим", "vse-materialy", sub=True) }}
</div></section>

{{ m.trucks(trucks) }}

<section class="d-band"><div class="wrap">
  {{ m.shelf(shelf_rows, "Ориентировочные цены", price_note) }}
  <p class="d-note">{{ delivery_note }}</p>
  {{ m.sh("Как можно заплатить", "oplata", sub=True) }}
  {{ m.payways(payment) }}
</div></section>

{% if reviews %}<section class="d-band d-band-tint"><div class="wrap">
  {{ m.sh("Отзывы", "otzyvy") }}
  {{ m.reviews(reviews) }}
</div></section>
{% endif %}

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.sh("Частые вопросы", "faq") }}
  {{ m.faq(faq) }}
</div></section>

<section class="d-band"><div class="wrap">
  {{ m.chips(related_links, "Смотрите также") }}
</div></section>
{% endblock %}
