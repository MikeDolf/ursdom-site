<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#1e293b">
<title>{{ title }}</title>
<meta name="description" content="{{ desc }}">
<link rel="canonical" href="{{ canonical }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="ru_RU">
<meta property="og:site_name" content="{{ cfg.brand }}">
<meta property="og:title" content="{{ og_title|default(title) }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ cfg.og_image }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="stylesheet" href="/dostavka/assets/dostavka.css?v={{ cfg.css_version }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<script type="application/ld+json">
{{ jsonld }}
</script>
</head>
<body>
<a class="d-skip" href="#content">К содержимому</a>
<header class="d-header">
  <div class="wrap">
    <a class="d-logo" href="/dostavka/">Щебень<span>-Урал</span></a>
    <div class="d-head-phone">
      <a href="{{ cfg.phone_href }}" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','call')}catch(e){}">{{ cfg.phone }}</a>
      <small>{{ cfg.hours }}, {{ cfg.callback_promise }}</small>
    </div>
  </div>
</header>
<nav class="d-crumbs" aria-label="Хлебные крошки"><div class="wrap">{{ crumbs_html }}</div></nav>
<main id="content">
{% block body %}{% endblock %}
</main>
<footer class="d-footer">
  <div class="wrap">
    <div class="d-foot-grid">
      <div>
        <h3>{{ cfg.brand }}</h3>
        <p>{{ cfg.tagline }} по {{ cfg.region }}.</p>
        <p>{{ cfg.payment }}</p>
      </div>
      <div>
        <h3>Контакты</h3>
        <p><a href="{{ cfg.phone_href }}">{{ cfg.phone }}</a><br><small>{{ cfg.hours }}</small></p>
        <p><a href="{{ cfg.max_url }}" target="_blank" rel="noopener">Написать в MAX</a></p>
        <p><a href="mailto:{{ cfg.email }}">{{ cfg.email }}</a></p>
      </div>
      <div>
        <h3>Материалы</h3>
        <p><a href="/dostavka/shcheben/">Доставка щебня</a><br>
        <a href="/dostavka/pesok/">Доставка песка</a><br>
        <a href="/dostavka/">Все города и материалы</a></p>
      </div>
    </div>
    <p class="d-copy">© 2026 {{ cfg.brand }}. Доставка нерудных материалов по {{ cfg.region }}. Цены на сайте ориентировочные, точную стоимость называем по заявке.</p>
  </div>
</footer>
<div class="d-mobilebar">
  <a class="call" href="{{ cfg.phone_href }}" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','call')}catch(e){}">Позвонить</a>
  <a class="max" href="{{ cfg.max_url }}" target="_blank" rel="noopener">MAX</a>
</div>
<script type="text/javascript">
   (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
   m[i].l=1*new Date();
   for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
   k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
   (window, document, "script", "https://mc.yandex.ru/metrika/tag.js?id={{ cfg.metrika_id }}", "ym");
   ym({{ cfg.metrika_id }}, "init", {ssr:true, webvisor:true, clickmap:true, accurateTrackBounce:true, trackLinks:true});
</script>
<noscript><div><img src="https://mc.yandex.ru/watch/{{ cfg.metrika_id }}" style="position:absolute; left:-9999px;" alt=""></div></noscript>
</body>
</html>
