{% import "_macros.j2" as m %}<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#1b2530">
<title>{{ title }}</title>
<meta name="description" content="{{ desc }}">
<link rel="canonical" href="{{ canonical }}">
{% if noindex %}<meta name="robots" content="noindex,follow">
{% endif %}
{# og:type различает статью и остальные страницы: у 59 лонгридов тип
   article, у товарных и рубричных website. Раньше website стоял всюду,
   и статья в пересылке выглядела как обычная страница сайта. #}
<meta property="og:type" content="{{ og_type|default('website') }}">
<meta property="og:locale" content="ru_RU">
<meta property="og:site_name" content="{{ cfg.brand }}">
<meta property="og:title" content="{{ og_title|default(title) }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ canonical }}">
{# Обложка страницы: если у страницы есть собственные снимки, в пересылку
   идёт первый из них, иначе общая обложка раздела. og_image приходит
   абсолютным из _photo_ctx: Open Graph относительных путей не понимает. #}
<meta property="og:image" content="{{ og_image|default(cfg.og_image) }}">
{# Размеры объявляются настоящие: у снимка материала они свои,
   а не 1200 на 630, как у общей обложки. #}
<meta property="og:image:width" content="{{ og_w|default(1200) }}">
<meta property="og:image:height" content="{{ og_h|default(630) }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title|default(title) }}">
<meta name="twitter:description" content="{{ desc }}">
<meta name="twitter:image" content="{{ og_image|default(cfg.og_image) }}">
<link rel="preload" href="/dostavka/assets/fonts/golos-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/dostavka/assets/fonts/mono-num.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/dostavka/assets/dostavka.min.css?v={{ cfg.css_version }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<script type="application/ld+json">
{{ jsonld }}
</script>
<!-- Yandex Autoplacement 20037714 -->
<script src="https://yandex.ru/ads/system/context.js" async></script>
<script data-page-id="20037714" src="https://yandex.ru/ads/system/ap-loader.js" async></script>
</head>
<body>
<!--
  DIRECTION CONTRACT · «Рассев» · seed 0aacaa17

  THESIS: this site is the instrument that grades stone by size, not a
  brochure about delivery. It refuses the category default of a dark hero
  with a truck photo, three trust cards and a price table below.

  OWN-WORLD: steel #1b2530 carries whole fields; enamel #eef1ec carries
  content; graph #5d7b88 is ruling only; brass #d9a548 is action only and
  always takes steel ink, never white. One 2px radius, no soft cards, no
  kicker pills. Woven sieve mesh whose cell step is computed from the real
  fraction in millimetres. Golos Text for words, JetBrains Mono for every
  digit on the site, cap-height matched.

  STORY: a buyer who does not know which fraction to order sees four sieves
  with real mesh, real stone and a real price, picks one, and asks for a
  quote already knowing the word for what they want.

  FIRST VIEWPORT: steel field. H1 left at up to 46px, one line of subhead,
  brass MAX button beside an outlined form button, then the sieve stack
  full width: four rows, mesh 104px at left, fraction, use, price at right.
  Primary action is the brass button; the stack is the second entry.

  FORM: sieve stack, first on the ordered list of seven, seed key 0aacaa17.

  FINISH: unreviewed and undocumented is unfinished; this build ends with
  the finish review, the verdict, DESIGN.md, and every shipping raster
  carrying its provenance.
-->
<a class="d-skip" href="#content">К содержимому</a>
{# Служебная полоса. Факты, которые человек ищет глазами в первую
   секунду: где мы работаем, когда работаем и куда писать письмом.
   Полоса не липкая - она уезжает вместе со страницей, а прилипает
   ниже сама шапка, где действие. Телефон отсюда убран: владелец
   попросил не держать его на виду вообще нигде выше содержимого
   страницы, только внизу, где его ищут осознанно (см. подвал). #}
<div class="d-topbar"><div class="wrap">
  <span class="d-topbar-geo">{{ cfg.region }}</span>
  <span class="d-topbar-sep" aria-hidden="true"></span>
  <span class="d-topbar-hours">{{ cfg.hours }}</span>
  <span class="d-topbar-sale">{{ cfg.promo }}</span>
  {# Адрес базы первым: на телефоне из всей полосы видна только правая
     часть, и раньше это была одна личная почта на gmail, первое, что
     видел человек. Адрес со ссылкой на контакты говорит о компании
     больше. Почта осталась рядом: владелец просил её здесь держать. #}
  <span class="d-topbar-right">
    <a href="/dostavka/kontakty/">{{ cfg.street }}</a>
    <a href="mailto:{{ cfg.email }}">{{ cfg.email }}</a>
  </span>
</div></div>
<header class="d-header">
  <div class="wrap">
    <a class="d-logo" href="/dostavka/">Щебень<span>-Урал</span></a>
    {# Владелец попросил убрать из шапки номер и повесить туда два
       мессенджера. Номер никуда не делся: он в подвале и на странице
       контактов, где его ищут осознанно. В шапке же он занимал место
       действия, а нажимают на него редко: разговор требует решимости,
       сообщение нет. #}
    <div class="d-head-links">
      <a class="d-head-ic" href="{{ cfg.max_url }}" target="_blank" rel="noopener"
         aria-label="Написать в MAX, {{ cfg.reply_promise }}"
         onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">
        {{ m.max_badge('head') }}<span>MAX</span></a>
    </div>
  </div>
</header>
<nav class="d-crumbs" aria-label="Хлебные крошки"><div class="wrap">{{ crumbs_html }}</div></nav>
<main id="content">
{% block body %}{% endblock %}
</main>
{# Полоса «Наша техника и доставки». Коммерческие шаблоны ставят её выше,
   сразу под блоком цен, и переопределяют этот блок пустым: фото
   реальных выгрузок работают на доверие там, где человек решает,
   а не под подвалом. Остальные страницы получают её здесь. #}
{% block fleet %}{% if not no_cta %}{{ m.fleet_strip(fleet_photos) }}{% endif %}{% endblock %}
<footer class="d-footer">
  <div class="wrap">
    <div class="d-foot-grid">
      <div>
        <h3>{{ cfg.brand }}</h3>
        <p>{{ cfg.tagline }} по {{ cfg.region_dat }}.</p>
        <p>{{ cfg.payment }}</p>
      </div>
      <div>
        <h3>Контакты</h3>
        <p>{{ cfg.hours }}</p>
        <p><a href="{{ cfg.max_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">Написать в MAX</a></p>
        <p><a href="mailto:{{ cfg.email }}">{{ cfg.email }}</a></p>
        <p><a href="/dostavka/kontakty/">Контакты, адрес и реквизиты</a><br>
        <small>{{ cfg.city }}, {{ cfg.street }}</small></p>
      </div>
      <div>
        <h3>Материалы</h3>
        <p><a href="/dostavka/shcheben/">Доставка щебня</a><br>
        <a href="/dostavka/pesok/">Доставка песка</a><br>
        <a href="/dostavka/kalkulyator/">Калькуляторы объёма и веса</a><br>
        <a href="/dostavka/">Все города и материалы</a><br>
        <a href="/dostavka/politika/">Обработка данных</a></p>
      </div>
    </div>
    <p class="d-copy">© 2026 {{ cfg.brand }}. Доставка нерудных материалов по {{ cfg.region_dat }}. Цены на сайте ориентировочные, точную стоимость называем по заявке.</p>
    {# Телефон - самая нижняя строка страницы. Владелец попросил убрать
       его из служебной полосы вверху: там он был на виду у каждого,
       кто просто листает, а разговор по телефону требует решимости,
       которой в первую секунду ни у кого нет. Внизу его находит тот,
       кто уже дочитал до конца и целенаправленно ищет номер. #}
    <p class="d-phone-bottom"><a href="{{ cfg.phone_href }}" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">{{ cfg.phone }}</a></p>
  </div>
</footer>
<script src="/dostavka/assets/wa.js?v={{ cfg.css_version }}" defer></script>
{% if has_calc %}<script src="/dostavka/assets/calc.js?v={{ cfg.css_version }}" defer></script>{% endif %}
{% if vc %}<script src="/dostavka/assets/calcpage.js?v={{ cfg.css_version }}" defer></script>{% endif %}

{{ m.float_block(cfg) }}
{# Липкая панель на телефоне: MAX, WhatsApp и «Узнать цену» в одной
   полосе внизу экрана.

   Как пришли к этой раскладке. Сначала в панели стояли три кнопки
   с плоскими белыми значками, а в шапке и в плавающих кружках те же
   сервисы были цветными, и владелец справедливо сказал, что всё
   дублируется. Мессенджеры из панели убрали, а на телефоне оставили
   плавающие кружки над ней: владелец просил, чтобы иконки всплывали
   при прокрутке.

   Кружки на телефоне ложились поверх страницы: замер на странице
   щебня показал перекрытие ссылок и кнопок в 13 точках прокрутки
   из 36, в том числе поля «Телефон» в форме заявки и стрелок в частых
   вопросах. Поэтому на телефоне те же цветные значки, что в шапке,
   переехали в панель. Они по-прежнему появляются на прокрутке
   и никуда не пропадают (wa.js), но стоят в полосе, под которую
   у страницы есть нижний отступ, а не поверх текста. На компьютере
   кружки остались от 1164 px: там они стоят на поле справа от колонки
   текста (режимы по ширине в dostavka.css у .d-float). #}
{% if not no_cta %}<div class="d-mobilebar">
  <a class="msg" href="{{ cfg.max_url }}" target="_blank" rel="noopener"
     aria-label="Написать в MAX, {{ cfg.reply_promise }}"
     onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">{{ m.max_badge('bar') }}<span>MAX</span></a>
  <a class="call" href="{{ form_anchor|default('#zayavka') }}">Узнать цену<b>Скидка {{ cfg.promo_pct }}% за заявку</b></a>
</div>
{% endif %}
{# Всплывающее окно .d-pop удалено при ревью интерфейса.
   На телефоне в правом нижнем углу одновременно оказались три
   перекрывающих призыва: липкая панель .d-mobilebar, это окно
   и плавающий виджет WhatsApp. Все три ведут в одни и те же два
   действия. Окно убрано как самое навязчивое из трёх: оно закрывало
   контент и требовало закрытия кнопкой. Панель и виджет разведены
   по высоте и больше не пересекаются. #}

<script type="text/javascript">
   (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
   m[i].l=1*new Date();
   for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
   k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
   (window, document, "script", "https://mc.yandex.ru/metrika/tag.js?id={{ cfg.metrika_id }}", "ym");
   ym({{ cfg.metrika_id }}, "init", {ssr:true, webvisor:true, clickmap:true, accurateTrackBounce:true, trackLinks:true});
</script>
<noscript><div><img src="https://mc.yandex.ru/watch/{{ cfg.metrika_id }}" style="position:absolute; left:-9999px;" alt=""></div></noscript>
{% block tail %}{% endblock %}
</body>
</html>
