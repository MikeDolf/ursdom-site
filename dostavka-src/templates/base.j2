   onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_wa }}')}catch(e){}">
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.23 8.23 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.17 1.72 2.62 4.16 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"/></svg>
  <span>Написать в WhatsApp<b>{{ cfg.wa_promise }}</b></span>
</a>
{% if not no_cta %}<div class="d-mobilebar">
  <a class="max" href="{{ cfg.max_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">Написать в MAX</a>
  <a class="call" href="{{ form_anchor|default('#zayavka') }}">Узнать цену</a>
</div>
{% endif %}
{% if not no_cta %}<aside class="d-pop" id="d-pop" aria-label="Связаться с нами" hidden>
  <button class="d-pop-x" type="button" aria-label="Закрыть окно">×</button>
  <strong>Связаться с нами</strong>
  <p>Назовите материал, объём и адрес: посчитаем цену с доставкой и {{ cfg.callback_promise }}.</p>
  <a class="d-pop-max" href="{{ cfg.max_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">Написать в MAX</a>
  <a class="d-pop-lead" href="{{ form_anchor|default('#zayavka') }}">Узнать цену с доставкой</a>
  <small>{{ cfg.hours }}</small>
</aside>
{% endif %}
<script>
(function(){
  var el=document.getElementById('d-pop');
  if(!el) return;
  // Закрыли один раз - не показываем до конца сессии.
  try{ if(sessionStorage.getItem('dpop')==='off') return; }catch(e){}
  el.hidden=false;
  var shown=false;
  function check(){
    // Показываем после прокрутки на экран с небольшим запасом.
    if(!shown && window.pageYOffset > window.innerHeight*0.8){
      shown=true; el.classList.add('is-on');
      window.removeEventListener('scroll',check);
    }
  }
  window.addEventListener('scroll',check,{passive:true});
  check();
  function close(){
    el.classList.remove('is-on');
    try{ sessionStorage.setItem('dpop','off'); }catch(e){}
  }
  el.querySelector('.d-pop-x').addEventListener('click',close);
  el.querySelector('.d-pop-lead').addEventListener('click',close);
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') close(); });
})();
</script>
