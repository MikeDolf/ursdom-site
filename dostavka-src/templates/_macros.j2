{# Стопка сит: главный объект дизайн-кода «Рассев».
   Каждая строка - одно сито. Ячейка нарисована в вёрстке с шагом --cell,
   который выведен из настоящего размера фракции в миллиметрах (см. SIEVE
   в data/prices.py). На ячейке лежат зёрна, и они заведомо крупнее
   отверстия: ширина зерна равна 1,35 × --cell, потому что через сито
   проходит только то, что мельче ячейки. Силуэты угловатые, а не круглые:
   щебень колотый, окатанной формы у него нет.  #}
{% macro stone(i) -%}
<svg class="d-sieve-stone" viewBox="0 0 40 34" aria-hidden="true" focusable="false">
{%- if i == 1 %}<path d="M2 16 L13 3 L20 8 L31 1 L38 15 L30 22 L34 28 L17 33 L8 26 Z"/>
{%- elif i == 2 %}<path d="M5 10 L18 1 L24 9 L35 4 L39 19 L27 24 L29 31 L12 29 L1 19 Z"/>
{%- else %}<path d="M1 13 L11 4 L22 7 L28 1 L38 12 L31 19 L37 27 L19 33 L5 25 Z"/>
{%- endif %}</svg>
{%- endmacro %}

{# Боковое сито в герое. На широком экране правая половина стального поля
   иначе стоит пустой, а пустота - ровно та претензия, с которой начался
   этот редизайн. Панель показывает ячейку страницы в крупном масштабе:
   на песке она мелкая, на буте крупная, шаг тот же --cell, что и у полосы
   внизу. Сама сетка декоративна для скринридера и скрыта, подпись - нет:
   она называет фракцию словами. #}
{% macro hero_panel(label) -%}
<aside class="d-hero-panel">
  <span class="d-hero-mesh" aria-hidden="true">{{ stone(1) }}{{ stone(2) }}{{ stone(3) }}</span>
  <span class="d-hero-cap">Ячейка страницы<b>{{ label }}</b></span>
</aside>
{%- endmacro %}

{% macro sieve(rows) -%}
<ol class="d-sieve" aria-label="Фракции нерудных материалов по возрастанию размера зерна">
{% for mm,cell,frac,name,use,price,href in rows %}  <li class="d-sieve-row" style="--cell:{{ cell }}px">
    <span class="d-sieve-mesh">{{ stone(1) }}{{ stone(2) }}{{ stone(3) }}</span>
    <span>
      <a class="d-sieve-frac" href="{{ href }}">{{ frac }} <i>мм</i></a>
      <span class="d-sieve-name">{{ name }}</span>
    </span>
    <span class="d-sieve-use">{{ use }}</span>
    <span class="d-sieve-price">{{ price }} <i>руб/м³</i></span>
  </li>
{% endfor %}</ol>
<p class="d-sieve-note">Ячейка на каждой строке нарисована в масштабе: шаг сетки взят
от настоящего размера фракции, поэтому разницу между отсевом и щебнем 20-40 видно,
не переходя на страницу. Цены ориентировочные,
<a href="#zayavka">точную с доставкой называем по заявке</a>.</p>
{%- endmacro %}

{# Иконки мессенджеров. Обе нарисованы одним контуром и красятся
   currentColor: фирменные цвета сервисов (зелёный и синий) спорили бы
   и со сталью, и с латунью одновременно, а два чужих бренда рядом
   превратили бы шапку в чужую витрину. Форма узнаётся без цвета.

   Знак MAX это не логотип сервиса, а буквенная марка: рисовать чужой
   логотип по памяти значит нарисовать его неправильно. #}
{% macro wa_icon() -%}
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.23 8.23 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.17 1.72 2.62 4.16 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"/></svg>
{%- endmacro %}

{% macro max_icon() -%}
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 3h18a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-9.6l-4.6 3.6A.8.8 0 0 1 5.5 21v-3H3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm3.1 4.6v6.8h1.7v-4.2l1.8 3h.5l1.8-3v4.2h1.7V7.6h-1.7l-2.05 3.4L7.8 7.6H6.1Zm9.05 6.8 2.35-3.3 2.35 3.3h-1.9l-.45-.68-.45.68h-1.9Zm4.7-6.8h-1.9l-.45.68-.45-.68h-1.9l2.35 3.3 2.35-3.3Z"/></svg>
{%- endmacro %}

{# Плавающий блок связи. Раньше здесь висел один WhatsApp, и он же
   прятался, когда рядом оказывался блок связи или форма. Владелец
   сказал прямо: кнопка появляется, потом пропадает, и MAX в ней нет.
   Оба замечания верные, поэтому:

   1. каналов теперь два, как и везде на сайте;
   2. блок больше не прячется от блоков связи. Он показывается один раз,
      когда человек ушёл с первого экрана, и дальше стоит на месте.
      Мигание раздражало сильнее, чем перекрытие, ради которого оно
      было сделано, а перекрытие снято отступом: на телефоне блок
      стоит над липкой панелью, и нижние блоки связи получили поле
      под него.

   На узком экране остаются два кружка с иконками, подписи уходят
   в aria-label. #}
{% macro float_block(cfg) -%}
<div class="d-float" aria-label="Написать нам">
  <a class="d-float-btn d-float-wa" href="{{ cfg.wa_url }}" target="_blank" rel="noopener"
     aria-label="Написать в WhatsApp, {{ cfg.wa_promise }}"
     onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_wa }}')}catch(e){}">
    {{ wa_icon() }}<span>WhatsApp<b>{{ cfg.wa_promise }}</b></span></a>
  <a class="d-float-btn d-float-mx" href="{{ cfg.max_url }}" target="_blank" rel="noopener"
     aria-label="Написать в MAX"
     onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">
    {{ max_icon() }}<span>MAX<b>ответим в рабочее время</b></span></a>
</div>
{%- endmacro %}

{# Сетка снимков. Один слот на весь сайт: раньше разметка галереи жила
   только в money.j2, и на статьи, рубрики и контакты фотографию было
   некуда положить, даже когда она есть.

   Размеры width и height проставлены всегда: без них браузер не знает
   пропорцию до загрузки файла, и страница прыгает под пальцем, когда
   картинка приезжает. Это же считается как сдвиг макета в Core Web Vitals.

   loading=lazy стоит на всех снимках галереи: она всегда ниже первого
   экрана. На первом экране lazy ставить нельзя, там он замедляет показ. #}
{% macro photos(items, head=None, intro=None) -%}
{% if items %}{% if head %}  <h2 id="foto">{{ head }}</h2>
{% endif %}{% if intro %}  <p>{{ intro }}</p>
{% endif %}  <div class="d-photos">
{% for ph in items %}    <figure>
      <picture>
{% if ph.webp %}        <source type="image/webp" srcset="{{ ph.webp }}" sizes="(max-width: 700px) 100vw, 46vw">
{% endif %}        <img src="{{ ph.src }}" srcset="{{ ph.jpg }}" sizes="(max-width: 700px) 100vw, 46vw"
             alt="{{ ph.alt }}" width="{{ ph.w }}" height="{{ ph.h }}"
             loading="lazy" decoding="async">
      </picture>
      <figcaption>{{ ph.cap }}</figcaption>
    </figure>
{% endfor %}  </div>
{% endif %}
{%- endmacro %}

{% macro lead_form(cfg, subject) -%}
<form class="d-form" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value="{{ cfg.web3forms_key }}">
  <input type="hidden" name="redirect" value="{{ cfg.domain }}{{ cfg.base }}spasibo/">
  <input type="hidden" name="subject" value="Заявка: {{ subject }}">
  <input type="hidden" name="from_name" value="{{ cfg.brand }}, сайт">
  <input type="text" name="botcheck" class="d-hp" tabindex="-1" autocomplete="off">
  <label for="lf-name">Ваше имя</label>
  <input id="lf-name" type="text" name="Имя" required>
  <label for="lf-phone">Телефон для связи</label>
  <input id="lf-phone" type="tel" name="Телефон" placeholder="+7" required>
  <label for="lf-msg">Что и куда привезти</label>
  <textarea id="lf-msg" name="Заявка" placeholder="Например: щебень 20-40, 10 кубов, Первоуральск, адрес"></textarea>
  <label class="d-consent"><input type="checkbox" name="Согласие" value="да" required>
    <span>Согласен на обработку персональных данных для ответа на заявку, включая
    передачу через зарубежный сервис отправки форм.
    <a href="/dostavka/politika/">Как мы обрабатываем данные</a></span></label>
  <button class="d-btn d-btn-wide" type="submit">Отправить заявку</button>
  <p class="d-note">{{ cfg.callback_promise|capitalize }}. Заявка ни к чему не обязывает.</p>
</form>
{%- endmacro %}

{# Блок контактов внутри секции заявки. Собственного h2 у него нет:
   раньше рядом стояли «Связаться с нами» и «Посчитаем объём», два
   заголовка второго уровня на одно и то же действие. Теперь секция
   несёт один заголовок, а колонки подписаны третьим уровнем. #}
{% macro callblock(cfg) -%}
<div class="d-callblock">
  <h3>Написать напрямую</h3>
  <p>Напишите материал, объём и адрес, посчитаем стоимость с доставкой и {{ cfg.callback_promise }}.</p>
  <a class="d-bigmax" href="{{ cfg.wa_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_wa }}')}catch(e){}">Написать в WhatsApp, {{ cfg.wa_promise }}</a>
  <div class="d-cta-row d-center-row">
    <a class="d-btn d-btn-ghost" href="{{ cfg.max_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">Написать в MAX</a>
    <a class="d-btn d-btn-ghost" href="#zayavka">Узнать цену с доставкой</a>
  </div>
  <p class="d-note d-note-light">{{ cfg.hours }}. {{ cfg.payment }}</p>
</div>
{%- endmacro %}

{% macro advantages(items) -%}
<div class="d-grid">
{% for t,d in items %}  <div class="d-card"><strong>{{ t }}</strong><p>{{ d }}</p></div>
{% endfor %}</div>
{%- endmacro %}

{% macro guarantees(items) -%}
<ul>
{% for g in items %}  <li>{{ g }}</li>
{% endfor %}</ul>
{%- endmacro %}

{% macro faq(items) -%}
<div class="d-faq">
{% for q,a in items %}  <details><summary>{{ q }}</summary><div><p>{{ a }}</p></div></details>
{% endfor %}</div>
{%- endmacro %}

{# Ряд каналов связи. Один макрос на весь сайт.

   Ревью паритета показало разнобой: калькулятор предлагал только
   WhatsApp, а первый экран, блок связи, липкая панель и призыв в тексте
   только MAX. Человек видел разные каналы на разных экранах одного
   сайта и не понимал, куда писать. Владелец просил оба канала, значит
   оба стоят везде, где вообще есть кнопка мессенджера.

   Порядок: WhatsApp латунью как главное действие, потому что именно
   у него обещано время ответа, MAX контуром рядом. Цели в Метрике
   разные, поэтому видно, какой канал работает. Третья кнопка
   необязательна и задаётся вызывающим. #}
{% macro channels(cfg, third_href=None, third_text=None, center=False) -%}
<div class="d-cta-row{% if center %} d-center-row{% endif %}">
  <a class="d-btn d-btn-max" href="{{ cfg.wa_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_wa }}')}catch(e){}">Написать в WhatsApp</a>
  <a class="d-btn d-btn-ghost" href="{{ cfg.max_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">Написать в MAX</a>
{% if third_href %}  <a class="d-btn d-btn-ghost" href="{{ third_href }}">{{ third_text }}</a>
{% endif %}</div>
{%- endmacro %}

{% macro midcta(cfg, headline, text) -%}
<div class="d-midcta">
  <h3>{{ headline }}</h3>
  <p>{{ text }}</p>
  {{ channels(cfg, "#zayavka", "Узнать цену с доставкой") }}
</div>
{%- endmacro %}

{# Ценовой якорь под врезкой «коротко». Статья на 1500 слов без единой
   цифры в рублях оставляла главный вопрос читателя без ответа до самого
   конца, а чаще навсегда. Полоса даёт цифру сразу и короткий путь вниз,
   к полному прайсу и порядку заказа. #}
{% macro pricebar(anchor) -%}
<div class="d-pricebar">
  <b>{{ anchor }}</b>
  <a href="#skolko-stoit">Все цены и как заказать</a>
</div>
{%- endmacro %}

{# Блок в конце статьи. До него текст обрывался, и читатель попадал
   сразу в «Как мы возим»: между дочитанным материалом и заявкой
   не было ни одного шага. #}
{% macro order_block(cfg, head, rows, steps, price_note, note=None) -%}
<h2 id="skolko-stoit">{{ head }}</h2>
<div class="d-table-wrap"><table>
  <caption>{{ price_note }}</caption>
  <thead><tr><th>Позиция</th><th>Цена с доставкой</th></tr></thead>
  <tbody>
{% for name,price,href in rows %}    <tr><td><a href="{{ href }}">{{ name }}</a></td><td>{{ price }}</td></tr>
{% endfor %}  </tbody>
</table></div>
{% if note %}<p class="d-note">{{ note }}</p>
{% endif %}
<h3 id="kak-zakazat-dostavku">Как заказать доставку</h3>
<ol class="d-steps">
{% for s in steps %}  <li>{{ s }}</li>
{% endfor %}</ol>
{%- endmacro %}

{# Возражения, которые до этого выяснялись только в переписке, то есть
   уже после того, как человек решился написать. Стоят рядом с формой:
   это последнее, что читают перед отправкой заявки.

   Сюда же свёрнут бывший тёмный блок «Как мы возим». Это была вторая
   сетка карточек того же жанра, «почему нам можно верить», и стояла
   она через экран от первой. Владелец, глядя на страницу, сказал, что
   всё навалено, и был прав: в хвосте статьи подряд шли восемь
   заголовков второго уровня, шесть из них про одно и то же действие.
   Одна сетка вместо двух, один заголовок вместо двух. #}
{% macro objections(items, extra=None, note=None) -%}
<h2>Что важно знать до заявки</h2>
{% if note %}<p>{{ note }}</p>
{% endif %}<div class="d-grid">
{% for t,d in items %}  <div class="d-card"><strong>{{ t }}</strong><p>{{ d }}</p></div>
{% endfor %}{% if extra %}{% for t,d in extra %}  <div class="d-card"><strong>{{ t }}</strong><p>{{ d }}</p></div>
{% endfor %}{% endif %}</div>
{%- endmacro %}

{# Калькулятор доставки.

   Работает БЕЗ JavaScript: ниже рендерится настоящая таблица примеров,
   она видна поисковику, читается со скринридера и остаётся рабочей при
   отключённом скрипте. Скрипт только надстраивает интерактив: подменяет
   таблицу на форму с ползунком. Обратный порядок дал бы пустой блок
   и в индексе, и у части посетителей.

   Результат везде подписан как предварительный. Тариф назван владельцем
   как «очень примерно», и калькулятор обязан говорить это вслух,
   а не выдавать цифру за счёт. #}
{% macro calculator(cfg, calc) -%}
<section class="d-calc" id="kalkulyator"
         data-rate="{{ calc.rate }}" data-min="{{ calc.min_volume }}">
  <h2>Калькулятор доставки</h2>
  <p class="d-calc-lead">Считает материал, число рейсов и плечо доставки по тарифу
  {{ calc.rate }} рублей за километр. Расчёт предварительный: тариф зависит от сезона,
  заезда и загрузки машин, точную сумму называем по заявке.</p>

  <div class="d-calc-ui" hidden>
    <div class="d-calc-row">
      <label for="calc-mat">Материал</label>
      <select id="calc-mat">
{% for name,price in calc.materials %}        <option value="{{ price }}">{{ name }}, {{ price }} руб/м³</option>
{% endfor %}      </select>
    </div>
    <div class="d-calc-row">
      <label for="calc-vol">Объём: <output id="calc-vol-out">10</output> м³</label>
      <input id="calc-vol" type="range" min="1" max="40" step="1" value="10">
    </div>
    <div class="d-calc-row">
      <label for="calc-dest">Куда везём</label>
      <select id="calc-dest">
{% for name,km in calc.destinations %}        <option value="{{ km }}"{% if km == 25 %} selected{% endif %}>{{ name }}, {{ km }} км</option>
{% endfor %}      </select>
    </div>
    <output class="d-calc-out" id="calc-out" aria-live="polite">
      <table class="d-calc-table"><tbody>
        <tr><th scope="row">Материал</th><td class="d-calc-formula">{{ calc.start.vol }} м³ × {{ calc.start.price_s }} руб</td><td>{{ calc.start.material_s }} руб</td></tr>
        <tr><th scope="row">Доставка</th><td class="d-calc-formula">{{ calc.start.trips }} рейс × {{ calc.start.km }} км × {{ calc.rate }} руб</td><td>{{ calc.start.delivery_s }} руб</td></tr>
        <tr class="d-calc-total"><th scope="row" colspan="2">Итого предварительно</th><td>{{ calc.start.total_s }} руб</td></tr>
      </tbody></table>
      <p class="d-note">Кузов {{ calc.start.capacity }} м³. Расчёт предварительный,
      точную сумму называем по заявке.</p>
    </output>
    {{ channels(cfg, "#zayavka", "Оставить заявку") }}
  </div>

  <div class="d-calc-static">
    <div class="d-table-wrap"><table>
      <caption>Примеры расчёта: {{ calc.examples.material }} по {{ calc.examples.price }} руб/м³,
      доставка {{ calc.rate }} руб/км</caption>
      <thead><tr><th>Объём</th><th>Куда</th><th>Плечо</th><th>Рейсы</th>
      <th>Материал, руб</th><th>Доставка, руб</th><th>Итого, руб</th></tr></thead>
      <tbody>
{% for r in calc.examples.rows %}        <tr>{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>
{% endfor %}      </tbody>
    </table></div>
    <p class="d-note">Объём сверх {{ calc.trucks[-1][0] }} м³ везётся несколькими рейсами,
    и плечо оплачивается за каждый. Заказ меньше {{ calc.min_volume }} м³ возможен,
    но рейс оплачивается целиком, поэтому куб выходит дороже.</p>
  </div>
</section>
{%- endmacro %}

{% macro author_block(author, updated) -%}
<div class="d-author">
  <div class="d-ava" aria-hidden="true">{{ author.initials }}</div>
  <div>
    <strong>{{ author.name }}</strong>
    <p>{{ author.role }}. {{ author.bio }}</p>
  </div>
</div>
<p class="d-upd">Материал обновлён {{ updated }}. Цифры проверены по действующим ГОСТам и практике отгрузок по Свердловской области.</p>
{%- endmacro %}

{% macro blocks(s) -%}
{% if s.p %}{% for para in s.p %}  <p>{{ para|xlink }}</p>
{% endfor %}{% endif %}
{%- if s.callout %}  <div class="d-callout{% if s.callout_warn %} d-warn{% endif %}"><p><strong>{{ s.callout[0] }}</strong> {{ s.callout[1] }}</p></div>
{% endif %}
{%- if s.ul %}  <ul>
{% for i in s.ul %}    <li>{{ i|xlink }}</li>
{% endfor %}  </ul>
{% endif %}
{%- if s.steps %}  <ol class="d-steps">
{% for i in s.steps %}    <li>{{ i }}</li>
{% endfor %}  </ol>
{% endif %}
{%- if s.table %}  <div class="d-table-wrap"><table>
    <caption>{{ s.table.caption }}</caption>
    <thead><tr>{% for th in s.table.head %}<th>{{ th }}</th>{% endfor %}</tr></thead>
    <tbody>
{% for row in s.table.rows %}      <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}
{%- if s.sub %}{% for sb in s.sub %}  <h3>{{ sb.h3 }}</h3>
{% for para in sb.p %}  <p>{{ para|xlink }}</p>
{% endfor %}{% if sb.ul %}  <ul>
{% for i in sb.ul %}    <li>{{ i|xlink }}</li>
{% endfor %}  </ul>
{% endif %}{% endfor %}{% endif %}
{%- if s.after %}{% for para in s.after %}  <p>{{ para|xlink }}</p>
{% endfor %}{% endif %}
{%- endmacro %}

{% macro related(links) -%}
<nav class="d-related" aria-label="Смотрите также">
  <h2>Смотрите также</h2>
  <ul>
{% for href,txt in links %}    <li><a href="{{ href }}">{{ txt }}</a></li>
{% endfor %}  </ul>
</nav>
{%- endmacro %}
