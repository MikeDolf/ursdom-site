{# Боковая панель первого экрана. Здесь была нарисованная сетка сита
   с силуэтами камней; владелец сказал, что схематичные изображения
   доверия не вызывают, и на коммерческой странице он прав: рисунок
   вместо товара читается как «фотографии у них нет».

   Подпись называет то, что НА СНИМКЕ, а не тему страницы. Разница
   существенная: на странице бетонных колец в панели стоит самосвал,
   и подпись говорит про самосвал, а не про кольца.

   Панель необязательна: если файла снимка нет, макрос не рендерит
   ничего и правая половина стального поля просто остаётся полем. #}
{% macro hero_panel(label, img=None) -%}
{% if img %}<aside class="d-hero-panel">
  <span class="d-hero-ph">
    <picture>
      <source type="image/webp" srcset="{{ img.webp }}" sizes="(max-width:899px) 0px, 40vw">
      <img src="{{ img.src }}" srcset="{{ img.jpg }}" sizes="(max-width:899px) 0px, 40vw"
           alt="{{ label }}, фотография материала на нашей базе"
           width="{{ img.w }}" height="{{ img.h }}"
           loading="eager" fetchpriority="high" decoding="async">
    </picture>
  </span>
  <span class="d-hero-cap">На фото<b>{{ label }}</b></span>
</aside>
{% endif %}
{%- endmacro %}

{# Стопка фракций: главный объект первого экрана хаба. Каждая строка -
   размер зерна, назначение и цена, и человек выбирает фракцию, не уходя
   со страницы.

   Слева был нарисован квадрат сетки с шагом от реальных миллиметров.
   Идея честная - масштаб настоящий, - но на коммерческом сайте она
   проигрывает простому снимку: рисунок объясняет размер, а фотография
   показывает материал, и покупателю нужно второе. #}
{% macro sieve(rows) -%}
<ol class="d-sieve" aria-label="Фракции нерудных материалов по возрастанию размера зерна">
{% for mm,cell,frac,name,use,price,href,img in rows %}  <li class="d-sieve-row">
    <span class="d-sieve-ph">
{% if img %}      <picture>
        <source type="image/webp" srcset="{{ img.webp }}" sizes="(max-width:560px) 64px, (max-width:900px) 84px, 104px">
        <img src="{{ img.src }}" srcset="{{ img.jpg }}" sizes="(max-width:560px) 64px, (max-width:900px) 84px, 104px"
             alt="{{ name }}, фракция {{ frac }} мм" width="{{ img.w }}" height="{{ img.h }}"
             loading="eager" decoding="async">
      </picture>
{% endif %}    </span>
    <span>
      <a class="d-sieve-frac" href="{{ href }}">{{ frac }} <i>мм</i></a>
      <span class="d-sieve-name">{{ name }}</span>
    </span>
    <span class="d-sieve-use">{{ use }}</span>
    <span class="d-sieve-price">{{ price }} <i>руб/м³</i></span>
  </li>
{% endfor %}</ol>
<p class="d-sieve-note">Снимки наши, с базы и с карьера: по ним видно и цвет породы,
и форму зерна, и реальный размер камня. Цены ориентировочные,
<a href="#zayavka">точную с доставкой называем по заявке</a>.</p>
{%- endmacro %}

{# Иконки мессенджеров. Обе нарисованы одним контуром и красятся
   currentColor: фирменные цвета сервисов (зелёный и синий) спорили бы
   и со сталью, и с латунью одновременно, а два чужих бренда рядом
   превратили бы шапку в чужую витрину. Форма узнаётся без цвета.

   Знак MAX это не логотип сервиса, а буквенная марка: рисовать чужой
   логотип по памяти значит нарисовать его неправильно. #}
{% macro wa_icon() -%}
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.23 8.23 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.17 1.72 2.62 4.16 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"/></svg>
{%- endmacro %}

{% macro max_icon() -%}
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 3h18a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-9.6l-4.6 3.6A.8.8 0 0 1 5.5 21v-3H3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm3.1 4.6v6.8h1.7v-4.2l1.8 3h.5l1.8-3v4.2h1.7V7.6h-1.7l-2.05 3.4L7.8 7.6H6.1Zm9.05 6.8 2.35-3.3 2.35 3.3h-1.9l-.45-.68-.45.68h-1.9Zm4.7-6.8h-1.9l-.45.68-.45-.68h-1.9l2.35 3.3 2.35-3.3Z"/></svg>
{%- endmacro %}

{# Значки-плашки в фирменных цветах сервисов, вместо контурных wa_icon/max_icon.
   Используются только в шапке и в плавающем блоке связи - двух местах, где
   кнопка не залита латунью/сталью и цвету есть куда лечь. Везде ещё,
   где кнопка сама залита цветом дизайн-кода (кнопки форм, подвал, таблица
   контактов), знак остаётся контурным: класть чужой зелёный/синий поверх
   латуни было бы двойным цветовым пятном.
   uid обязателен: значок вставляется на страницу дважды (шапка и плавающий
   блок), а id градиента должен быть уникален в документе. #}
{% macro max_badge(uid) -%}
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="mx-g-{{ uid }}" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7B5CFA"/><stop offset=".55" stop-color="#4C8CFF"/><stop offset="1" stop-color="#38D9E8"/>
    </linearGradient>
    <mask id="mx-m-{{ uid }}"><rect width="24" height="24" fill="#fff"/><circle cx="13.9" cy="9.7" r="3.35"/></mask>
  </defs>
  <rect width="24" height="24" rx="3" fill="url(#mx-g-{{ uid }})"/>
  <circle cx="12" cy="10.1" r="6.3" fill="#fff" mask="url(#mx-m-{{ uid }})"/>
  <path d="M6.55 13.55 9.95 12.9 8.0 18.15Z" fill="#fff"/>
</svg>
{%- endmacro %}

{# Плавающий блок связи. Раньше здесь висел один WhatsApp, и он же
   прятался, когда рядом оказывался блок связи или форма. Владелец
   сказал прямо: кнопка появляется, потом пропадает, и MAX в ней нет.
   Оба замечания верные, поэтому:

   1. каналов теперь два, как и везде на сайте;
   2. блок больше не прячется от блоков связи. Он показывается один раз,
      когда человек ушёл с первого экрана, и дальше стоит на месте.
      Мигание раздражало сильнее, чем перекрытие, ради которого оно
      было сделано, а перекрытие снято отступом: на телефоне блок
      стоит над липкой панелью, и нижние блоки связи получили поле
      под него.

   На узком экране остаются два кружка с иконками, подписи уходят
   в aria-label.

   MAX стоит первым, а обещание ответа у обеих кнопок одно: владелец
   говорит, что пишут в основном в MAX и отвечает он там за те же пять
   минут. Прежний разнобой («за 5 минут» против «в рабочее время»)
   и ширину кнопок разводил, и понижал MAX до запасного канала. #}
{% macro float_block(cfg) -%}
<div class="d-float" aria-label="Написать нам">
  <a class="d-float-btn" href="{{ cfg.max_url }}" target="_blank" rel="noopener"
     aria-label="Написать в MAX, {{ cfg.reply_promise }}"
     onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">
    {{ max_badge('float') }}<span>MAX<b>{{ cfg.reply_promise }}</b></span></a>
</div>
{%- endmacro %}

{# Сетка снимков. Один слот на весь сайт: раньше разметка галереи жила
   только в money.j2, и на статьи, рубрики и контакты фотографию было
   некуда положить, даже когда она есть.

   Размеры width и height проставлены всегда: без них браузер не знает
   пропорцию до загрузки файла, и страница прыгает под пальцем, когда
   картинка приезжает. Это же считается как сдвиг макета в Core Web Vitals.

   loading=lazy стоит на всех снимках галереи: она всегда ниже первого
   экрана. На первом экране lazy ставить нельзя, там он замедляет показ. #}
{# Витрина прайса. Раньше на этом месте стояла таблица «материал - цена»:
   она честно отвечала на вопрос «сколько стоит» и никак - на вопрос
   «мне такой или другой», с которым человек на самом деле приходит.
   Из двух строк с числами разницу между 20-40 и 40-70 не узнать,
   и её уходят выяснять на другой сайт.

   Шапка карточки - настоящий снимок; стоковых на сайте не бывает,
   все кадры свои. Позиции без снимка рендерятся вовсе без шапки:
   пустой тёмный прямоугольник хуже, чем карточка пониже соседних,
   и заметнее - на него сразу хочется найти фотографию.

   Здесь была сетка сита вместо недостающего снимка, и она честно
   отработала два дня, пока владелец не прислал кадры скалы и щебня
   70-120 - последних двух позиций без фото. Держать написанные стили
   ради ветки, в которую больше не заходят, проверка проекта не даёт
   и правильно делает: вернуть шесть строк из истории дешевле,
   чем носить мёртвый код.

   Ссылка на имени НЕ растянута на карточку псевдоэлементом, в отличие
   от плиток каталога на хабе: здесь внутри есть вторая цель, кнопка
   заказа, и растянутая ссылка накрыла бы её собой. #}
{% macro shelf(rows, head=None, note=None) -%}
{% if head %}  <h2 class="d-sh" id="ceny">{{ head }}</h2>
{% endif %}  <div class="d-shelf">
{% for r in rows %}    <article class="d-shelf-item">
{% if r.img %}      <div class="d-shelf-ph">
        <picture>
          <source type="image/webp" srcset="{{ r.img.webp }}" sizes="(max-width:700px) 50vw, 300px">
          <img src="{{ r.img.src }}" srcset="{{ r.img.jpg }}" sizes="(max-width:700px) 50vw, 300px"
               alt="{{ r.alt }}" width="{{ r.img.w }}" height="{{ r.img.h }}"
               loading="lazy" decoding="async">
        </picture>
      </div>
{% endif %}
      <div class="d-shelf-in">
        <h3 class="d-shelf-name">{% if r.href %}<a href="{{ r.href }}">{{ r.name }}</a>{% else %}{{ r.name }}{% endif %}</h3>
        <p class="d-shelf-use">{{ r.use }}</p>
        <p class="d-shelf-price">{{ r.price }} <small>руб/м³</small></p>
        <a class="d-btn d-shelf-buy" href="#zayavka">Заказать</a>
      </div>
    </article>
{% endfor %}  </div>
{% if note %}  <p class="d-note">{{ note }}</p>
{% endif %}
{%- endmacro %}

{# Способы оплаты. Вопрос «как платить» человек на этом рынке задаёт
   раньше вопроса «сколько», потому что за ним стоит страх предоплаты
   незнакомой конторе. Раньше ответ был одной строкой в блоке условий
   и терялся среди остального. #}
{% macro payways(groups, note=None) -%}
{% if note %}  <p class="d-pay-note">{{ icon("shield") }}<span><b>{{ note[0] }}.</b> {{ note[1] }}</span></p>
{% endif %}{% for head, items in groups %}  <h3 class="d-pay-h">{{ head }}</h3>
  <ul class="d-pay">
{% for ico, title, text in items %}    <li class="d-pay-item">
      {{ icon(ico) }}
      <strong>{{ title }}</strong>
      <span>{{ text }}</span>
    </li>
{% endfor %}  </ul>
{% endfor %}
{%- endmacro %}

{# Зоны доставки. У конкурента здесь карта области с закрашенными
   районами; мы показываем то, что на карте и ищут: своё направление,
   плечо в километрах и что оно значит для объёма заказа.

   Города со ссылками, поэтому блок работает ещё и списком населённых
   пунктов - только отсортированным по признаку, который двигает цену,
   а не по алфавиту. #}
{% macro zones(items, head, note=None) -%}
  <h2 class="d-sh d-sh-sub" id="zony">{{ head }}</h2>
{% if note %}  <p>{{ note }}</p>
{% endif %}  <div class="d-zones">
{% for z in items %}    <section class="d-zone">
      <h3 class="d-zone-h">{{ z.head }}<span class="d-zone-band">{{ z.band }}</span></h3>
      <p class="d-zone-note">{{ z.note }}</p>
      <ul class="d-zone-list">
{% for c in z.cities %}        <li><a href="{{ c.href }}">{{ c.name }}</a><i>{{ c.km }} км</i></li>
{% endfor %}      </ul>
    </section>
{% endfor %}  </div>
{%- endmacro %}

{# Перекрёстная витрина в конце страницы. Отличается от «Смотрите также»
   тем, что это товар, а не чтение: снимок, цена и вход в каталог.
   Текущий материал вычитается на сборке, поэтому страница не предлагает
   саму себя. #}
{% macro crossshelf(rows, head) -%}
{% if rows %}{% if head %}  <h2 class="d-sh">{{ head }}</h2>
{% endif %}
  <div class="d-shelf d-shelf-cross">
{% for r in rows %}    <article class="d-shelf-item">
{% if r.img %}      <div class="d-shelf-ph">
        <picture>
          <source type="image/webp" srcset="{{ r.img.webp }}" sizes="(max-width:700px) 50vw, 260px">
          <img src="{{ r.img.src }}" srcset="{{ r.img.jpg }}" sizes="(max-width:700px) 50vw, 260px"
               alt="{{ r.alt }}" width="{{ r.img.w }}" height="{{ r.img.h }}"
               loading="lazy" decoding="async">
        </picture>
      </div>
{% endif %}
      <div class="d-shelf-in">
        <h3 class="d-shelf-name"><a href="{{ r.href }}">{{ r.name }}</a></h3>
        <p class="d-shelf-use">{{ r.use }}</p>
{% if r.price %}        <p class="d-shelf-price">{{ r.price }} <small>руб/м³</small></p>
{% endif %}      </div>
    </article>
{% endfor %}  </div>
{% endif %}
{%- endmacro %}

{% macro photos(items, head=None, intro=None) -%}
{% if items %}{% if head %}  <h2 class="d-sh" id="foto">{{ head }}</h2>
{% endif %}{% if intro %}  <p>{{ intro }}</p>
{% endif %}  <div class="d-photos">
{% for ph in items %}    <figure>
      <picture>
{% if ph.webp %}        <source type="image/webp" srcset="{{ ph.webp }}" sizes="(max-width: 700px) 100vw, 46vw">
{% endif %}        <img src="{{ ph.src }}" srcset="{{ ph.jpg }}" sizes="(max-width: 700px) 100vw, 46vw"
             alt="{{ ph.alt }}" width="{{ ph.w }}" height="{{ ph.h }}"
             loading="lazy" decoding="async">
      </picture>
      <figcaption>{{ ph.cap }}</figcaption>
    </figure>
{% endfor %}  </div>
{% endif %}
{%- endmacro %}

{# Полоса доверия внизу каждой страницы сайта. Не галерея материала,
   а витрина техники и базы: один и тот же набор снимков подключён
   централизованно в base.j2, поэтому даже 3-4 годных кадра парка
   получают выход сразу на все страницы, а не на одну.

   Строка, а не сетка: на 157 страницах полноразмерная галерея
   повторялась бы слишком навязчиво. Здесь снимки идут узкой лентой
   под текстом, скорее подпись «вот с кем вы работаете», чем раздел
   для чтения. Список сознательно короткий: макрос ничего не рендерит
   при пустом items, поэтому пока снимков нет, страница не меняется. #}
{% macro fleet_strip(items) -%}
{% if items %}<section class="d-fleet"><div class="wrap">
  <h2>Наша техника и доставки</h2>
  <div class="d-fleet-row">
{% for ph in items %}    <figure>
      <picture>
{% if ph.webp %}        <source type="image/webp" srcset="{{ ph.webp }}" sizes="(max-width: 700px) 45vw, 220px">
{% endif %}        <img src="{{ ph.src }}" srcset="{{ ph.jpg }}" sizes="(max-width: 700px) 45vw, 220px"
             alt="{{ ph.alt }}" width="{{ ph.w }}" height="{{ ph.h }}"
             loading="lazy" decoding="async">
      </picture>
      <figcaption>{{ ph.cap }}</figcaption>
    </figure>
{% endfor %}  </div>
</div></section>
{% endif %}
{%- endmacro %}

{% macro lead_form(cfg, subject) -%}
<form class="d-form" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value="{{ cfg.web3forms_key }}">
  <input type="hidden" name="redirect" value="{{ cfg.domain }}{{ cfg.base }}spasibo/">
  <input type="hidden" name="subject" value="Заявка: {{ subject }}">
  <input type="hidden" name="from_name" value="{{ cfg.brand }}, сайт">
  {# Ловушка для ботов. Скрыта уводом за экран, а не display:none: часть
     ботов такие поля пропускает. Для скринридера её быть не должно,
     поэтому aria-hidden и tabindex="-1": без них Lighthouse справедливо
     ругался на поле формы без подписи. #}
  <input type="text" name="botcheck" class="d-hp" tabindex="-1" autocomplete="off"
         aria-hidden="true" aria-label="Оставьте это поле пустым">
  <label for="lf-name">Ваше имя</label>
  <input id="lf-name" type="text" name="Имя" required>
  <label for="lf-phone">Телефон для связи</label>
  <input id="lf-phone" type="tel" name="Телефон" placeholder="+7" required>
  <label for="lf-msg">Что и куда привезти</label>
  <textarea id="lf-msg" name="Заявка" placeholder="Например: щебень 20-40, 10 кубов, Первоуральск, адрес"></textarea>
  <label class="d-consent"><input type="checkbox" name="Согласие" value="да" required>
    <span>Согласен на обработку персональных данных для ответа на заявку, включая
    передачу через зарубежный сервис отправки форм.
    <a href="/dostavka/politika/">Как мы обрабатываем данные</a></span></label>
  {{ promo(cfg, "d-promo-form") }}
  <button class="d-btn d-btn-wide" type="submit">Отправить заявку</button>
  <p class="d-note">{{ cfg.callback_promise|capitalize }}. Заявка ни к чему не обязывает.</p>
</form>
{%- endmacro %}

{# Блок контактов внутри секции заявки. Собственного h2 у него нет:
   раньше рядом стояли «Связаться с нами» и «Посчитаем объём», два
   заголовка второго уровня на одно и то же действие. Теперь секция
   несёт один заголовок, а колонки подписаны третьим уровнем. #}
{% macro callblock(cfg) -%}
<div class="d-callblock">
  <h3>Написать напрямую</h3>
  <p>Напишите материал, объём и адрес, посчитаем стоимость с доставкой и {{ cfg.callback_promise }}.</p>
  <a class="d-bigmax" href="{{ cfg.max_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">Написать в MAX, {{ cfg.reply_promise }}</a>
  <div class="d-cta-row d-center-row">
    <a class="d-btn d-btn-ghost" href="#zayavka">Узнать цену с доставкой</a>
  </div>
  <p class="d-note d-note-light">{{ cfg.hours }}. {{ cfg.payment }}</p>
</div>
{%- endmacro %}

{% macro advantages(items) -%}
<div class="d-grid">
{% for t,d in items %}  <div class="d-card"><strong>{{ t }}</strong><p>{{ d }}</p></div>
{% endfor %}</div>
{%- endmacro %}

{% macro guarantees(items) -%}
<ul>
{% for g in items %}  <li>{{ g }}</li>
{% endfor %}</ul>
{%- endmacro %}

{% macro faq(items) -%}
<div class="d-faq">
{% for q,a in items %}  <details><summary>{{ q }}</summary><div><p>{{ a }}</p></div></details>
{% endfor %}</div>
{%- endmacro %}

{# Отзывы клиентов. Список REVIEWS сейчас пуст (см. data/reviews.py) -
   ни одной выдуманной записи, поэтому макрос рендерит пустую строку,
   пока владелец не пришлёт реальные тексты. Звёзды выводятся символами,
   а не картинкой: масштабируются с текстом и не тянут лишний запрос.
   Оценка ставится самим клиентом и не округляется - показываем как есть. #}
{% macro reviews(items) -%}
{% if items %}<div class="d-reviews">
{% for r in items %}  <div class="d-review">
    <div class="d-review-head">
      <strong>{{ r.name }}</strong>
{% if r.role %}      <span class="d-review-role">{{ r.role }}</span>
{% endif %}      <span class="d-review-stars" aria-label="Оценка {{ r.rating }} из 5">{{ '★' * r.rating }}{{ '☆' * (5 - r.rating) }}</span>
    </div>
    <p>{{ r.text }}</p>
{% if r.verified %}    <p class="d-review-verified">Подтверждённая заявка</p>
{% endif %}  </div>
{% endfor %}</div>
{% endif %}
{%- endmacro %}

{# Ряд каналов связи. Один макрос на весь сайт.

   Ревью паритета показало разнобой: калькулятор предлагал только
   WhatsApp, а первый экран, блок связи, липкая панель и призыв в тексте
   только MAX. Человек видел разные каналы на разных экранах одного
   сайта и не понимал, куда писать. Владелец просил оба канала, значит
   оба стоят везде, где вообще есть кнопка мессенджера.

   Позже владелец убрал WhatsApp совсем: туда никто не пишет. Остался
   один канал, MAX, зелёной кнопкой крупнее прежней. Третья кнопка
   необязательна и задаётся вызывающим. #}
{# Плашка скидки за заявку онлайн. Стоит перед каждой кнопкой MAX
   (через channels) и над кнопкой отправки формы: там, где человек
   решает написать. #}
{% macro promo(cfg, cls="") -%}
<p class="d-promo{% if cls %} {{ cls }}{% endif %}"><b class="d-promo-pct">{{ cfg.promo_pct }}%</b><span>{{ cfg.promo }}</span></p>
{%- endmacro %}

{% macro channels(cfg, third_href=None, third_text=None, center=False) -%}
{{ promo(cfg) }}
<div class="d-cta-row{% if center %} d-center-row{% endif %}">
  <a class="d-btn d-btn-max" href="{{ cfg.max_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">Написать в MAX</a>
{% if third_href %}  <a class="d-btn d-btn-ghost" href="{{ third_href }}">{{ third_text }}</a>
{% endif %}</div>
{%- endmacro %}

{% macro midcta(cfg, headline, text) -%}
<div class="d-midcta">
  <h3>{{ headline }}</h3>
  <p>{{ text }}</p>
  {{ channels(cfg, "#zayavka", "Узнать цену с доставкой") }}
</div>
{%- endmacro %}

{# Ценовой якорь под врезкой «коротко». Статья на 1500 слов без единой
   цифры в рублях оставляла главный вопрос читателя без ответа до самого
   конца, а чаще навсегда. Полоса даёт цифру сразу и короткий путь вниз,
   к полному прайсу и порядку заказа. #}
{% macro pricebar(anchor) -%}
<div class="d-pricebar">
  <b>{{ anchor }}</b>
  <a href="#skolko-stoit">Все цены и как заказать</a>
</div>
{%- endmacro %}

{# Блок в конце статьи. До него текст обрывался, и читатель попадал
   сразу в «Как мы возим»: между дочитанным материалом и заявкой
   не было ни одного шага. #}
{% macro order_block(cfg, head, rows, steps, price_note, note=None) -%}
<h2 class="d-sh" id="skolko-stoit">{{ head }}</h2>
<div class="d-table-wrap"><table>
  <caption>{{ price_note }}</caption>
  <thead><tr><th>Позиция</th><th>Цена с доставкой</th></tr></thead>
  <tbody>
{% for name,price,href in rows %}    <tr><td><a href="{{ href }}">{{ name }}</a></td><td>{{ price }}</td></tr>
{% endfor %}  </tbody>
</table></div>
{% if note %}<p class="d-note">{{ note }}</p>
{% endif %}
<h3 id="kak-zakazat-dostavku">Как заказать доставку</h3>
<ol class="d-steps">
{% for s in steps %}  <li>{{ s }}</li>
{% endfor %}</ol>
{%- endmacro %}

{# Возражения, которые до этого выяснялись только в переписке, то есть
   уже после того, как человек решился написать. Стоят рядом с формой:
   это последнее, что читают перед отправкой заявки.

   Сюда же свёрнут бывший тёмный блок «Как мы возим». Это была вторая
   сетка карточек того же жанра, «почему нам можно верить», и стояла
   она через экран от первой. Владелец, глядя на страницу, сказал, что
   всё навалено, и был прав: в хвосте статьи подряд шли восемь
   заголовков второго уровня, шесть из них про одно и то же действие.
   Одна сетка вместо двух, один заголовок вместо двух. #}
{% macro objections(items, extra=None, note=None) -%}
<h2 class="d-sh">Что важно знать до заявки</h2>
{% if note %}<p>{{ note }}</p>
{% endif %}<div class="d-grid">
{% for t,d in items %}  <div class="d-card"><strong>{{ t }}</strong><p>{{ d }}</p></div>
{% endfor %}{% if extra %}{% for t,d in extra %}  <div class="d-card"><strong>{{ t }}</strong><p>{{ d }}</p></div>
{% endfor %}{% endif %}</div>
{%- endmacro %}

{# Калькулятор доставки.

   Работает БЕЗ JavaScript: ниже рендерится настоящая таблица примеров,
   она видна поисковику, читается со скринридера и остаётся рабочей при
   отключённом скрипте. Скрипт только надстраивает интерактив: подменяет
   таблицу на форму с ползунком. Обратный порядок дал бы пустой блок
   и в индексе, и у части посетителей.

   Результат везде подписан как предварительный. Тариф назван владельцем
   как «очень примерно», и калькулятор обязан говорить это вслух,
   а не выдавать цифру за счёт. #}
{% macro calculator(cfg, calc, lots=None) -%}
<section class="d-calc" id="kalkulyator"
         data-rate="{{ calc.rate }}" data-trip="{{ calc.round_trip }}" data-min="{{ calc.min_volume }}">
  <h2>{{ calc.head or "Калькулятор доставки" }}</h2>
  <p class="d-calc-lead">Считает материал, число рейсов и плечо доставки по тарифу
  {{ calc.rate }} рублей за километр. Плечо считаем от ближайшей площадки отгрузки,
  в Екатеринбурге или в Верхней Пышме, и в обе стороны: машина едет к вам
  и возвращается порожняком. Расчёт предварительный: тариф зависит от сезона,
  заезда и загрузки машин, точную сумму называем по заявке.</p>

  <div class="d-calc-ui" hidden>
    <div class="d-calc-form">
    <div class="d-calc-row">
      <label for="calc-mat">Материал</label>
      <select id="calc-mat">
{% for name,price in calc.materials %}        <option value="{{ price }}"{% if calc.sel_mat and name == calc.sel_mat %} selected{% endif %}>{{ name }}, {{ price }} руб/м³</option>
{% endfor %}      </select>
    </div>
    <div class="d-calc-row">
      <label for="calc-vol">Объём: <output id="calc-vol-out">{{ calc.start.vol }}</output> м³</label>
      <input id="calc-vol" type="range" min="1" max="40" step="1" value="{{ calc.start.vol }}">
    </div>
    <div class="d-calc-row">
      <label for="calc-dest">Куда везём</label>
      <select id="calc-dest">
{# Выбор по имени, а не по километражу: у Арамили, Ревды и Первоуральска
   плечо совпадает с соседями, и «selected» по числу отмечал сразу
   несколько строк, из которых браузер брал последнюю. #}
{% for name,km in calc.destinations %}        <option value="{{ km }}"{% if name == (calc.sel_dest or "Екатеринбург и ближний пояс") %} selected{% endif %}>{{ name }}, {{ km }} км</option>
{% endfor %}      </select>
    </div>
    </div>
    <div class="d-calc-res">
    <output class="d-calc-out" id="calc-out" aria-live="polite">
      <table class="d-calc-table"><tbody>
        <tr><th scope="row">Материал</th><td class="d-calc-formula">{{ calc.start.vol }} м³ × {{ calc.start.price_s }} руб</td><td>{{ calc.start.material_s }} руб</td></tr>
        <tr><th scope="row">Доставка</th><td class="d-calc-formula">{{ calc.start.trips }} рейс × {{ calc.start.km * calc.round_trip }} км × {{ calc.rate }} руб</td><td>{{ calc.start.delivery_s }} руб</td></tr>
        <tr class="d-calc-total"><th scope="row" colspan="2">Итого предварительно</th><td>{{ calc.start.total_s }} руб</td></tr>
      </tbody></table>
      <p class="d-note">Кузов {{ calc.start.capacity }} м³. Расчёт предварительный,
      точную сумму называем по заявке.</p>
    </output>
    {{ channels(cfg, "#zayavka", "Узнать точную цену") }}
{% if lots %}    <p class="d-note">На ходовые объёмы по Екатеринбургу выше есть
    <a href="#obemy">фиксированная цена за машину</a>, и она выгоднее этого расчёта:
    там доставка входит в стоимость загрузки, а здесь считается по километражу.
    Калькулятор нужен для нестандартных объёмов и для доставки за город.</p>
{% endif %}    </div>
  </div>

{% if calc.static is not defined or calc.static %}  <div class="d-calc-static">
    <div class="d-table-wrap"><table>
      <caption>Примеры расчёта: {{ calc.examples.material }} по {{ calc.examples.price }} руб/м³,
      доставка {{ calc.rate }} руб/км в обе стороны. В колонке «Плечо» расстояние
      в одну сторону, оплачивается путь туда и обратно.</caption>
      <thead><tr><th>Объём</th><th>Куда</th><th>Плечо</th><th>Рейсы</th>
      <th>Материал, руб</th><th>Доставка, руб</th><th>Итого, руб</th></tr></thead>
      <tbody>
{% for r in calc.examples.rows %}        <tr>{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>
{% endfor %}      </tbody>
    </table></div>
    <p class="d-note">Объём сверх {{ calc.trucks[-1][0] }} м³ везётся несколькими рейсами,
    и плечо оплачивается за каждый. Заказ меньше {{ calc.min_volume }} м³ возможен,
    но рейс оплачивается целиком, поэтому куб выходит дороже.</p>
  </div>
{% endif %}
</section>
{%- endmacro %}

{# Калькулятор объёма по размерам площадки.

   Отвечает на вопрос, с которым на этот рынок и приходят: «сколько кубов
   надо на площадку 6 на 4». Раньше человек считал это в уме или на чужом
   сайте, и на чужом же оставался.

   Устроен как калькулятор доставки: на сборке рендерится настоящая
   таблица готовых расчётов, скрипт только надстраивает над ней поля.
   Без JavaScript блок остаётся рабочим и попадает в индекс.

   Коэффициент уплотнения берётся верхней границей диапазона: слой
   недосыпать хуже, чем пересыпать. Материалы, у которых коэффициента
   в наших текстах нет, считаются без запаса, и это сказано вслух. #}
{% macro volcalc(cfg, v) -%}
<section class="d-vc" id="obem"
         data-k="{{ v.k }}" data-dens-lo="{{ v.dens_lo or '' }}"
         data-dens-hi="{{ v.dens_hi or '' }}" data-price="{{ v.price }}">
  <h2>Сколько {{ v.name }} нужно: расчёт по размерам</h2>
  <p class="d-calc-lead">{{ v.lead }}</p>

  <div class="d-vc-ui" hidden>
    <div class="d-vc-form">
      <div class="d-vc-field">
        <label for="vc-l">Длина, м</label>
        <input id="vc-l" type="text" inputmode="decimal" autocomplete="off" value="{{ v.l }}">
      </div>
      <div class="d-vc-field">
        <label for="vc-w">Ширина, м</label>
        <input id="vc-w" type="text" inputmode="decimal" autocomplete="off" value="{{ v.w }}">
      </div>
      <div class="d-vc-field">
        <label for="vc-h">Толщина слоя, см</label>
        <input id="vc-h" type="text" inputmode="numeric" autocomplete="off" value="{{ v.layer }}">
      </div>
    </div>
    <output class="d-vc-out" id="vc-out" aria-live="polite"></output>
    {{ channels(cfg, "#zayavka", "Заказать этот объём") }}
  </div>

  <div class="d-vc-static">
    <div class="d-table-wrap"><table>
      <caption>{{ v.caption }}</caption>
      <thead><tr><th>Задача</th><th>Размеры</th><th>Слой</th><th>Объём{% if v.k > 1 %} с запасом{% endif %}</th>{% if v.dens_lo %}<th>Вес</th>{% endif %}<th>Машина</th></tr></thead>
      <tbody>
{% for r in v.rows %}        <tr><td>{{ r.task }}</td><td class="d-spec-val">{{ r.size }}</td><td class="d-spec-val">{{ r.layer }} см</td><td class="d-spec-val">{{ r.vol }} м³</td>{% if v.dens_lo %}<td class="d-spec-val">{{ r.tons }} т</td>{% endif %}<td>{{ r.truck }}</td></tr>
{% endfor %}      </tbody>
    </table></div>
  </div>
  <p class="d-note">{{ v.note }}</p>
</section>
{%- endmacro %}

{# Перевод тонн в кубы и обратно. Отдельный блок, потому что это отдельный
   вопрос: материал заказывают кубами, а взвешивают тоннами, и на этом
   расхождении чаще всего и спорят при приёмке.

   Показывается только там, где насыпная плотность есть в наших же
   текстах. Подставить «примерно полторы тонны» было бы проще, но это
   ровно тот вид вранья, который вскрывается на весах. #}
{% macro tonscalc(v) -%}
{% if v.dens_lo %}<section class="d-tc" id="ves"
         data-dens-lo="{{ v.dens_lo }}" data-dens-hi="{{ v.dens_hi }}">
  <h2>Перевести тонны в кубы и обратно</h2>
  <p class="d-calc-lead">Насыпная плотность {{ v.dens_s }} тонны на кубометр.
  {% if v.dens_note %}{{ v.dens_note }}{% endif %}</p>
  <div class="d-tc-ui" hidden>
    <div class="d-vc-form">
      <div class="d-vc-field">
        <label for="tc-m3">Кубометры</label>
        <input id="tc-m3" type="text" inputmode="decimal" autocomplete="off" value="10">
      </div>
      <div class="d-vc-field">
        <label for="tc-t">Тонны</label>
        <input id="tc-t" type="text" inputmode="decimal" autocomplete="off" value="">
      </div>
    </div>
    <output class="d-tc-out" id="tc-out" aria-live="polite"></output>
  </div>
  <div class="d-tc-static">
    <div class="d-table-wrap"><table>
      <caption>Готовый перевод по насыпной плотности {{ v.dens_s }} т/м³</caption>
      <thead><tr><th>Кубометры</th><th>Тонны</th><th>Тонны</th><th>Кубометры</th></tr></thead>
      <tbody>
{% for a,b,c,d in v.tons_rows %}        <tr><td class="d-spec-val">{{ a }}</td><td class="d-spec-val">{{ b }}</td><td class="d-spec-val">{{ c }}</td><td class="d-spec-val">{{ d }}</td></tr>
{% endfor %}      </tbody>
    </table></div>
  </div>
</section>
{% endif %}
{%- endmacro %}

{% macro author_block(author, updated) -%}
<div class="d-author">
  <div class="d-ava" aria-hidden="true">{{ author.initials }}</div>
  <div>
    <strong>{{ author.name }}</strong>
    <p>{{ author.role }}. {{ author.bio }}</p>
  </div>
</div>
<p class="d-upd">Материал обновлён {{ updated }}. Цифры проверены по действующим ГОСТам и практике отгрузок по Свердловской области.</p>
{%- endmacro %}

{% macro blocks(s) -%}
{% if s.p %}{% for para in s.p %}  <p>{{ para|xlink }}</p>
{% endfor %}{% endif %}
{%- if s.callout %}  <div class="d-callout{% if s.callout_warn %} d-warn{% endif %}"><p><strong>{{ s.callout[0] }}</strong> {{ s.callout[1] }}</p></div>
{% endif %}
{%- if s.ul %}  <ul>
{% for i in s.ul %}    <li>{{ i|xlink }}</li>
{% endfor %}  </ul>
{% endif %}
{%- if s.ol %}  <ol class="d-ol">
{% for i in s.ol %}    <li>{{ i|xlink }}</li>
{% endfor %}  </ol>
{% endif %}
{%- if s.steps %}  <ol class="d-steps">
{% for i in s.steps %}    <li>{{ i }}</li>
{% endfor %}  </ol>
{% endif %}
{%- if s.table %}  <div class="d-table-wrap"><table>
    <caption>{{ s.table.caption }}</caption>
    <thead><tr>{% for th in s.table.head %}<th>{{ th }}</th>{% endfor %}</tr></thead>
    <tbody>
{% for row in s.table.rows %}      <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}
{%- if s.sub %}{% for sb in s.sub %}  <h3>{{ sb.h3 }}</h3>
{% for para in sb.p %}  <p>{{ para|xlink }}</p>
{% endfor %}{% if sb.ul %}  <ul>
{% for i in sb.ul %}    <li>{{ i|xlink }}</li>
{% endfor %}  </ul>
{% endif %}{# Таблица внутри подраздела. Появилась при вычитке: пропорции
   бетона на цементе М500 были записаны прописью в одну строку -
   «М100 это один к пять восемь к восемь одному» - потому что таблицу
   сюда положить было некуда. Читать это невозможно, а данные ровно
   табличные, и в соседнем разделе они уже стоят таблицей. #}
{% if sb.table %}  <div class="d-table-wrap"><table>
    <caption>{{ sb.table.caption }}</caption>
    <thead><tr>{% for th in sb.table.head %}<th>{{ th }}</th>{% endfor %}</tr></thead>
    <tbody>
{% for row in sb.table.rows %}      <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}{% endfor %}{% endif %}
{%- if s.after %}{% for para in s.after %}  <p>{{ para|xlink }}</p>
{% endfor %}{% endif %}
{%- endmacro %}

{% macro related(links) -%}
<nav class="d-related" aria-label="Смотрите также">
  <h2 class="d-sh">Смотрите также</h2>
  <ul>
{% for href,txt in links %}    <li><a href="{{ href }}">{{ txt }}</a></li>
{% endfor %}  </ul>
</nav>
{%- endmacro %}

{# ================================================================
   БЛОКИ ПО ОБРАЗЦУ ВЛАДЕЛЬЦА (сентябрь 2026)

   Владелец прислал страницу своего второго проекта и попросил тот же
   порядок и то же устройство блоков во всём разделе: первый экран
   с фото, «сколько стоит», калькулятор, фото доставок, тёмная полоса
   с быстрой заявкой, гарантии карточками, цифры, шаги, форма в тёмной
   полосе, «проще написать», доставка и машины, таблицы, текст, частые
   вопросы. Цвета и шрифты остаются «Щебень-Урал»: темы и бренды двух
   сайтов разделены по требованию владельца, копируется схема, а не
   палитра.
   ================================================================ #}

{# Иконки одним контуром: 24×24, штрих currentColor. Нарисованы здесь,
   без библиотек: у сайта нет ни одной внешней зависимости в рантайме. #}
{% macro icon(name) -%}
{% set P = {
 "rub": "M8 20V4h5.5a4 4 0 0 1 0 8H6M6 16h8",
 "cube": "M12 3 4 7.5v9L12 21l8-4.5v-9L12 3ZM4 7.5l8 4.5 8-4.5M12 12v9",
 "truck": "M2 6h12v10H2zM14 9h4l4 4v3h-8M6.5 19.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM17.5 19.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z",
 "clock": "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 7v5l3.5 2",
 "shield": "M12 3 5 6v5.5c0 4.3 2.9 7.7 7 9.5 4.1-1.8 7-5.2 7-9.5V6l-7-3ZM9 12l2.2 2.2L15.5 10",
 "wallet": "M3 8h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8ZM3 8l11-4 1.5 4M16.5 14h1",
 "pin": "M12 21s-7-6.2-7-11.2a7 7 0 0 1 14 0C19 14.8 12 21 12 21ZM12 12.3a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z",
 "ruler": "M3.5 15.5 15.5 3.5l5 5-12 12-5-5ZM7.5 11.5l2 2M10.5 8.5l2 2M13.5 5.5l2 2",
 "chat": "M4 5h16v11H10l-5 4v-4H4V5ZM8 10h8M8 13h5",
 "check": "M5 12.5 9.5 17 19 7.5",
 "calc": "M6 3h12v18H6zM9 7h6M9 11h1M14 11h1M9 15h1M14 15h1M9 18h1M14 18h1",
 "route": "M6 19a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM18 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM6 14V9a3 3 0 0 1 3-3h6.5M18 10v5a3 3 0 0 1-3 3H8.5",
 "doc": "M7 3h7l5 5v13H7V3ZM14 3v5h5M10 13h6M10 17h6",
 "cash": "M3 7h18v10H3zM12 14.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM6.5 10v4M17.5 10v4",
 "card": "M3 6h18v12H3zM3 10h18M7 14.5h4",
 "bank": "M3 9.5 12 4l9 5.5M5 10v7.5M9.5 10v7.5M14.5 10v7.5M19 10v7.5M3 20h18",
 "hand": "M7 11V6.5a1.5 1.5 0 0 1 3 0V11M10 10V5a1.5 1.5 0 0 1 3 0v5M13 10V6a1.5 1.5 0 0 1 3 0v6M16 12V9a1.5 1.5 0 0 1 3 0v4c0 4.4-3 8-7.5 8-2.6 0-4.4-1.2-5.7-3.4L4 13.5a1.5 1.5 0 0 1 2.5-1.7L7 13"
} %}
<svg class="d-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ P[name] }}"/></svg>
{%- endmacro %}

{# Первый экран с настоящим снимком на фоне. Снимок лежит <picture>
   под затемнением, а не фоном в CSS: так работают srcset, приоритет
   загрузки и alt. Затемнение слева плотнее, где текст, и прозрачнее
   справа, где видно сам материал или машину. #}
{% macro hero2(h1, sub, bg=None, bg_alt=None, price=None, price_unit="руб за куб, доставка считается отдельно",
               note=None, cfg=None, third_href="#zayavka", third_text="Узнать цену с доставкой",
               phone=False) -%}
<section class="d-hero2">
{% if bg %}  <picture class="d-hero2-bg">
{% if bg.webp %}    <source type="image/webp" srcset="{{ bg.webp }}" sizes="100vw">
{% endif %}    <img src="{{ bg.src }}" srcset="{{ bg.jpg }}" sizes="100vw" alt="{{ bg.alt or bg_alt or '' }}"
         width="{{ bg.w }}" height="{{ bg.h }}" loading="eager" fetchpriority="high" decoding="async">
  </picture>
{% endif %}  <div class="wrap d-hero2-in">
    <h1>{{ h1 }}</h1>
    <p class="d-hero2-sub">{{ sub }}</p>
{% if price or note %}    <div class="d-hero2-facts">
{% if price %}      <p class="d-hero2-price"><b>{{ price }}</b><span>{{ price_unit }}</span></p>
{% endif %}{% if note %}      <p class="d-hero2-note">{{ icon("shield") }}<span>{{ note }}</span></p>
{% endif %}    </div>
{% endif %}{% if phone %}    <div class="d-cta-row">
      <a class="d-btn d-btn-max" href="{{ cfg.phone_href }}" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">{{ cfg.phone }}</a>
      <a class="d-btn d-btn-ghost" href="{{ cfg.max_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">Написать в MAX</a>
    </div>
{% else %}    {{ channels(cfg, third_href, third_text) }}
{% endif %}    {{ caller() if caller else "" }}
  </div>
</section>
{%- endmacro %}

{# Заголовок секции: латунная черта под ним, как в образце. #}
{% macro sh(text, id=None, lead=None, sub=False) -%}
<h2 class="d-sh{% if sub %} d-sh-sub{% endif %}"{% if id %} id="{{ id }}"{% endif %}>{{ text }}</h2>
{% if lead %}<p class="d-sh-lead">{{ lead }}</p>
{% endif %}
{%- endmacro %}

{# Лента реальных доставок: крупные снимки с прокруткой. Без скрипта это
   горизонтальная лента с прилипанием кадра; wa.js добавляет стрелки. #}
{% macro deliveries(items, head="Наши доставки и техника") -%}
{% if items %}<section class="d-band d-deliv" aria-label="{{ head }}" data-ui><div class="wrap">
  {{ sh(head) }}
  <div class="d-slides" tabindex="0">
{% for ph in items %}    <figure class="d-slide">
      <picture>
{% if ph.webp %}        <source type="image/webp" srcset="{{ ph.webp }}" sizes="(max-width:700px) 88vw, 760px">
{% endif %}        <img src="{{ ph.src }}" srcset="{{ ph.jpg }}" sizes="(max-width:700px) 88vw, 760px"
             alt="{{ ph.alt }}" width="{{ ph.w }}" height="{{ ph.h }}" loading="lazy" decoding="async">
      </picture>
      <figcaption>{{ ph.cap }}</figcaption>
    </figure>
{% endfor %}  </div>
  <div class="d-slides-nav" hidden>
    <button class="d-slides-btn" type="button" data-dir="-1" aria-label="Предыдущий снимок"><span aria-hidden="true">&#8249;</span></button>
    <button class="d-slides-btn" type="button" data-dir="1" aria-label="Следующий снимок"><span aria-hidden="true">&#8250;</span></button>
  </div>
</div></section>
{% endif %}
{%- endmacro %}

{# Быстрая заявка в тёмной полосе: телефон и что привезти. Полная форма
   стоит ниже, эта для тех, кто уже решил и не хочет листать. #}
{% macro quick_band(cfg, head, text, subject) -%}
<section class="d-band d-band-dark d-quickband" data-ui><div class="wrap d-split">
  <div>
    <h2 class="d-sh">{{ head }}</h2>
    <p>{{ text }}</p>
    <ul class="d-ticks">
      <li>{{ icon("check") }}Цена с доставкой до вашего адреса, а не «от»</li>
      <li>{{ icon("check") }}Объём посчитаем по размерам площадки</li>
      <li>{{ icon("check") }}{{ cfg.callback_promise|capitalize }}</li>
    </ul>
  </div>
  <form class="d-qform" action="https://api.web3forms.com/submit" method="POST">
    <input type="hidden" name="access_key" value="{{ cfg.web3forms_key }}">
    <input type="hidden" name="redirect" value="{{ cfg.domain }}{{ cfg.base }}spasibo/">
    <input type="hidden" name="subject" value="Быстрая заявка: {{ subject }}">
    <input type="hidden" name="from_name" value="{{ cfg.brand }}, сайт">
    <input type="text" name="botcheck" class="d-hp" tabindex="-1" autocomplete="off"
           aria-hidden="true" aria-label="Оставьте это поле пустым">
    <label for="qf-phone">Телефон</label>
    <input id="qf-phone" type="tel" name="Телефон" placeholder="+7" required>
    <label for="qf-msg">Что и куда привезти</label>
    <input id="qf-msg" type="text" name="Заявка" placeholder="Например: 10 кубов, адрес">
    <label class="d-consent"><input type="checkbox" name="Согласие" value="да" required>
      <span>Согласен на обработку персональных данных, включая передачу через зарубежный
      сервис отправки форм. <a href="/dostavka/politika/">Как мы обрабатываем данные</a></span></label>
    <button class="d-btn d-btn-wide" type="submit">Посчитать стоимость</button>
  </form>
</div></section>
{%- endmacro %}

{# Гарантии: тёмная полоса, карточки с иконками, под ней лента доверия.

   data-ui у всех блоков продающего хвоста: они одинаковы на всех
   страницах по замыслу, как шапка и подвал, и проверка похожести
   страниц (audit/_verify.py, группа 17) их не сравнивает. #}
{% macro guarantee_band(items, strip) -%}
<section class="d-band d-band-dark" data-ui><div class="wrap">
  {{ sh("Наши гарантии") }}
  <div class="d-icards d-icards-dark">
{% for ic, t, d in items %}    <div class="d-icard">{{ icon(ic) }}<h3>{{ t }}</h3><p>{{ d }}</p></div>
{% endfor %}  </div>
</div></section>
<aside class="d-trust" data-ui aria-label="Коротко о работе"><div class="wrap">
{% for ic, t, d in strip %}  <p class="d-trust-it">{{ icon(ic) }}<span><b>{{ t }}</b>{{ d }}</span></p>
{% endfor %}</div></aside>
{%- endmacro %}

{# «Почему заказывают у нас» и цифры под ними. #}
{% macro why_band(items, stats, cfg) -%}
<section class="d-band" data-ui><div class="wrap">
  {{ sh("Почему заказывают у нас") }}
  <div class="d-icards">
{% for ic, t, d in items %}    <div class="d-icard">{{ icon(ic) }}<h3>{{ t }}</h3><p>{{ d }}</p></div>
{% endfor %}  </div>
</div></section>
<section class="d-band d-band-tint d-stats-band" data-ui><div class="wrap">
  <div class="d-stats">
{% for num, unit, cap in stats %}    <div class="d-stat"><b>{{ num }}<small>{{ unit }}</small></b><span>{{ cap }}</span></div>
{% endfor %}  </div>
</div></section>
{%- endmacro %}

{# Как заказать: карточки с номером шага. #}
{% macro steps_band(head, items, note=None, id="kak-zakazat") -%}
<section class="d-band" data-ui><div class="wrap">
  {{ sh(head, id) }}
  <ol class="d-stepcards">
{% for t in items %}    <li><span class="d-stepnum">{{ loop.index }}</span><p>{{ t }}</p></li>
{% endfor %}  </ol>
{% if note %}  <p class="d-note">{{ note }}</p>
{% endif %}</div></section>
{%- endmacro %}

{# Заявка в тёмной полосе: слева зачем и как, справа форма на белой карточке. #}
{% macro form_band(cfg, form_head, subject, head="Оставить заявку", text=None) -%}
<section id="zayavka" class="d-band d-band-dark d-formband" data-ui><div class="wrap d-split">
  <div>
    <h2 class="d-sh">{{ head }}</h2>
    <p>{{ text or ("Напишите материал, объём и адрес: посчитаем стоимость с доставкой и " ~ cfg.callback_promise ~ ". Заявка ни к чему не обязывает.") }}</p>
    <ul class="d-ticks">
      <li>{{ icon("wallet") }}{{ cfg.payment }}</li>
      <li>{{ icon("ruler") }}Объём по паспорту кузова, проверка до разгрузки</li>
      <li>{{ icon("clock") }}{{ cfg.hours }}</li>
    </ul>
    {{ channels(cfg) }}
  </div>
  <div class="d-formcard">
    <h3>{{ form_head }}</h3>
    {{ lead_form(cfg, subject) }}
  </div>
</div></section>
{%- endmacro %}

{# «Проще написать?» карточкой, как в образце. #}
{% macro msg_card(cfg) -%}
<section class="d-band d-band-tint" data-ui><div class="wrap">
  <div class="d-msgcard">
    <div>
      <h2 class="d-msgcard-h">Проще написать? Мы в MAX</h2>
      <p>Пришлите размеры площадки или фото участка и адрес: {{ cfg.reply_promise }}, с объёмом и ценой машины.</p>
    </div>
    {{ channels(cfg) }}
  </div>
</div></section>
{%- endmacro %}

{# Три карточки фактов по доставке с врезкой снизу. #}
{% macro info_cards(items, note=None) -%}
<div class="d-infocards">
{% for ic, t, d in items %}  <div class="d-infocard">{{ icon(ic) }}<h3>{{ t }}</h3><p>{{ d }}</p></div>
{% endfor %}</div>
{% if note %}<div class="d-accent"><p>{{ note }}</p></div>
{% endif %}
{%- endmacro %}

{# Машины с фотографиями: что приедет и куда проходит. #}
{% macro trucks(items, head="Какая машина приедет") -%}
{% if items %}<section class="d-band d-band-tint" data-ui><div class="wrap">
  {{ sh(head, "mashiny") }}
  <div class="d-trucks">
{% for t in items %}    <figure class="d-truck">
{% if t.img %}      <picture>
{% if t.img.webp %}        <source type="image/webp" srcset="{{ t.img.webp }}" sizes="(max-width:700px) 88vw, 340px">
{% endif %}        <img src="{{ t.img.src }}" srcset="{{ t.img.jpg }}" sizes="(max-width:700px) 88vw, 340px"
             alt="{{ t.img.alt }}" width="{{ t.img.w }}" height="{{ t.img.h }}" loading="lazy" decoding="async">
      </picture>
{% endif %}      <figcaption><b>{{ t.name }}</b><span class="d-truck-vol">{{ t.vol }}</span><span>{{ t.text }}</span></figcaption>
    </figure>
{% endfor %}  </div>
</div></section>
{% endif %}
{%- endmacro %}

{# Плашки-ссылки: города, другие материалы, статьи. #}
{% macro chips(links, head=None, id=None, sub=False) -%}
{% if links %}{% if head %}{{ sh(head, id, sub=sub) }}{% endif %}
<ul class="d-chips">
{% for href, txt in links %}  <li><a href="{{ href }}">{{ txt }}</a></li>
{% endfor %}</ul>
{% endif %}
{%- endmacro %}

{# Весь коммерческий хвост по образцу одним вызовом: доставки, быстрая
   заявка, гарантии, почему мы, цифры, шаги, форма, «проще написать».
   Страница передаёт только то, что у неё своё. #}
{% macro sales_block(cfg, fleet_photos, g, quick_head, quick_text, subject, steps_head, steps, form_head, steps_note=None) -%}
{{ deliveries(fleet_photos) }}
{{ quick_band(cfg, quick_head, quick_text, subject) }}
{{ guarantee_band(g.guarantees, g.trust) }}
{{ why_band(g.why, g.stats, cfg) }}
{{ steps_band(steps_head, steps, steps_note) }}
{{ form_band(cfg, form_head, subject) }}
{{ msg_card(cfg) }}
{%- endmacro %}
