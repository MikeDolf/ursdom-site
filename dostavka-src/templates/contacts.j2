{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block fleet %}{% endblock %}
{% block body %}
{{ m.hero2(h1, hero_sub, bg=hero_img, bg_alt=(hero_cap ~ ", фотография") if hero_cap else None,
           cfg=cfg, phone=True) }}

{# Реквизиты и адрес. JSON-LD в шапке документа несёт те же данные для
   машин, поэтому микроформат h-card здесь не дублируется. #}
<section class="d-band"><div class="wrap d-prose">
  {{ m.sh("Кто мы и где находимся", "rekvizity") }}
  <div class="d-table-wrap"><table class="d-kv">
    <caption>Реквизиты и контакты {{ cfg.brand }}</caption>
    <tbody>
      <tr><th scope="row">Наименование</th><td>{{ cfg.legal_name }}</td></tr>
      <tr><th scope="row">Адрес базы</th><td>{{ cfg.city }}, {{ cfg.street }}</td></tr>
      <tr><th scope="row">Телефон</th><td><a href="{{ cfg.phone_href }}" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">{{ cfg.phone }}</a></td></tr>
      <tr><th scope="row">MAX</th><td><a href="{{ cfg.max_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">Написать, {{ cfg.reply_promise }}</a></td></tr>
      <tr><th scope="row">WhatsApp</th><td><a href="{{ cfg.wa_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_wa }}')}catch(e){}">Написать, {{ cfg.reply_promise }}</a></td></tr>
      <tr><th scope="row">Почта</th><td><a href="mailto:{{ cfg.email }}">{{ cfg.email }}</a></td></tr>
      <tr><th scope="row">Режим работы</th><td>{{ cfg.hours }}</td></tr>
      <tr><th scope="row">Оплата</th><td>{{ cfg.payment }}</td></tr>
{% if cfg.inn %}      <tr><th scope="row">ИНН</th><td>{{ cfg.inn }}</td></tr>
{% endif %}{% if cfg.ogrn %}      <tr><th scope="row">ОГРН</th><td>{{ cfg.ogrn }}</td></tr>
{% endif %}    </tbody>
  </table></div>
  <div class="d-map-wrap">
    <iframe src="https://www.google.com/maps?q={{ (cfg.city ~ ', ' ~ cfg.street) | urlencode }}&output=embed"
            width="100%" height="360" style="border:0" loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Схема проезда: {{ cfg.city }}, {{ cfg.street }}"></iframe>
  </div>
</div></section>

<section class="d-band d-band-tint"><div class="wrap d-prose">
{% for s in sections %}
  <h2 class="d-sh" id="{{ s.id }}">{{ s.h }}</h2>
{{ m.blocks(s) }}
{% endfor %}
</div></section>

{{ m.deliveries(fleet_photos) }}

{{ m.guarantee_band(g.guarantees, g.trust) }}

{{ m.why_band(g.why, g.stats, cfg) }}

{{ m.form_band(cfg, form_head, subject) }}

{{ m.msg_card(cfg) }}

{% if photos %}<section class="d-band"><div class="wrap d-prose">
  {{ m.photos(photos, photos_head, photos_intro) }}
</div></section>
{% endif %}

<section class="d-band"><div class="wrap">
  {{ m.objections(objections) }}
</div></section>

{% if reviews %}<section class="d-band d-band-tint"><div class="wrap">
  {{ m.sh("Отзывы", "otzyvy") }}
  {{ m.reviews(reviews) }}
</div></section>
{% endif %}

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.sh("Частые вопросы", "faq") }}
  {{ m.faq(faq) }}
</div></section>

<section class="d-band"><div class="wrap">
  {{ m.chips(related_links, "Смотрите также") }}
</div></section>
{% endblock %}
