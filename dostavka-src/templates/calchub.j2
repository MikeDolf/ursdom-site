{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block fleet %}{% endblock %}
{% block body %}
{{ m.hero2(h1, hero_sub, bg=hero_img, bg_alt=(hero_cap ~ ", фотография") if hero_cap else None,
           cfg=cfg, third_href="#vse", third_text="Выбрать материал") }}

<section class="d-band"><div class="wrap">
  {{ m.sh("Калькулятор по материалу", "vse", "На каждой странице три расчёта: объём по размерам площадки с запасом на уплотнение, перевод кубов в тонны и стоимость с доставкой на ваш адрес.") }}
  {{ m.crossshelf(cards, None) }}
</div></section>


{{ m.form_band(cfg, "Заявка на расчёт", subject, head="Посчитаем под ваш объект") }}

{{ m.deliveries(fleet_photos) }}

{{ m.guarantee_band(g.guarantees, g.trust) }}

<section class="d-band d-band-tint"><div class="wrap d-prose">
  {{ m.sh("По каким формулам считаем", "metodika") }}
{% for h, p in method %}  <h3>{{ h }}</h3>
{% for line in p %}  <p>{{ line }}</p>
{% endfor %}{% endfor %}
</div></section>

{{ m.msg_card(cfg) }}

<section class="d-band"><div class="wrap">
  {{ m.sh("Частые вопросы", "faq") }}
  {{ m.faq(faq) }}
</div></section>

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.chips(related_links, "Смотрите также") }}
</div></section>
{% endblock %}
