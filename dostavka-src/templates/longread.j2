{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block body %}
<section class="d-hero" style="--cell:{{ hero_cell|default(34) }}px"><div class="wrap d-hero-grid">
  <div class="d-hero-main">
  <h1>{{ h1 }}</h1>
  <p>{{ hero_sub }}</p>
  {{ m.channels(cfg, "#zayavka", "Рассчитать заявку") }}
  </div>
  {{ m.hero_panel(hero_cap|default("щебень 20-40 мм", true), hero_img|default(none, true)) }}
</div></section>

<section><div class="wrap d-prose">
{% if commercial %}
  <h2 id="ceny">{{ price_head }}</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ price_note }}</caption>
    <thead><tr><th>Материал</th><th>Цена за куб, руб</th></tr></thead>
    <tbody>
{% for name,price in per_cube %}      <tr><td>{{ name }}</td><td>{{ price }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
  <p class="d-note">{{ delivery_note }}</p>

  <h2 id="kak-zakazat">{{ order_head }}</h2>
  <ol class="d-steps">
    <li>Скажите материал и объём в кубах. Не знаете объём: назовите размеры участка работ, посчитаем сами.</li>
    <li>Назовите адрес и опишите заезд: ширина ворот, место для разворота и подъёма кузова.</li>
    <li>Получите точную цену с доставкой. {{ cfg.callback_promise|capitalize }}, на месте сумма не меняется.</li>
    <li>Принимаете машину на объекте и проверяете объём. {{ cfg.payment }}</li>
  </ol>

  {{ m.midcta(cfg, cta_head, cta_text) }}
{% endif %}
  {{ m.author_block(author, updated) }}
  <div class="d-tldr"><strong>Коротко, если некогда читать</strong><p>{{ lead }}</p></div>
{% if conv %}  {{ m.pricebar(conv.anchor) }}
{% endif %}  <div class="d-toc"><strong>О чём этот материал</strong>
    <ol>
{% for s in sections %}      <li><a href="#{{ s.id }}">{{ s.h }}</a></li>
{% endfor %}    </ol>
  </div>

{% for s in sections %}
  <h2 id="{{ s.id }}">{{ s.h }}</h2>
{{ m.blocks(s) }}
{% if loop.index == cta_after %}{{ m.midcta(cfg, cta_head2 or cta_head, cta_text2 or cta_text) }}{% endif %}
{% endfor %}
{{ m.photos(photos, photos_head, photos_intro) }}
{% if conv %}{{ m.order_block(cfg, conv.head, conv.rows, order_steps, price_note, conv.note) }}
{% endif %}{% if calc %}{{ m.calculator(cfg, calc) }}
{% endif %}{# Завершающий призыв не рендерится, если призыв в разделах
   уже сработал после последнего из них: тогда два одинаковых блока
   встают в пределах одного экрана. Ревью намерило 163-167 слов между
   ними на пяти страницах марок бетона. #}
{# Завершающий призыв не нужен, когда ниже уже стоит блок цен
   с порядком заказа: он повторяет то же самое через один экран. #}
{% if cta_after < sections|length and not conv %}  {{ m.midcta(cfg, cta_head, cta_text) }}
{% endif %}</div></section>

<section id="zayavka"><div class="wrap">
  <h2>Оставить заявку</h2>
  <div class="d-two">
  <div>{{ m.callblock(cfg) }}</div>
  <div>
    <h3>{{ form_head }}</h3>
    {{ m.lead_form(cfg, subject) }}
  </div>
  </div>
</div></section>

<section class="d-dark-sec"><div class="wrap">
  {{ m.objections(objections, None,
     "Самосвалы от 5 до 20 кубов по " ~ cfg.region_dat ~ ". Разгрузка на объекте, оплата после выгрузки, " ~ cfg.callback_promise ~ ".") }}
</div></section>

<section><div class="wrap">
  <h2>Частые вопросы</h2>
  {{ m.faq(faq) }}
</div></section>

<section><div class="wrap">
  {{ m.related(related_links) }}
</div></section>
{% endblock %}
