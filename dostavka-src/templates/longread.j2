{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{# Статьи, страницы фракций и марок бетона. Режим чтения: сначала сам
   материал целиком, без вставок посреди текста, потом коммерческий
   хвост в устройстве по образцу владельца: фото доставок, быстрая
   заявка, гарантии, порядок заказа, форма, «проще написать». #}
{% block fleet %}{% endblock %}
{% block body %}
{{ m.hero2(h1, hero_sub, bg=hero_img, bg_alt=(hero_cap ~ ", фотография") if hero_cap else None, cfg=cfg) }}

{% if commercial %}
<section class="d-band"><div class="wrap">
  {{ m.sh(price_head, "ceny") }}
  <div class="d-table-wrap"><table>
    <caption>{{ price_note }}</caption>
    <thead><tr><th>Материал</th><th>Цена за куб, руб</th></tr></thead>
    <tbody>
{% for name,price in per_cube %}      <tr><td>{{ name }}</td><td>{{ price }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
  <p class="d-note">{{ delivery_note }}</p>
</div></section>
{% endif %}

<section class="d-band"><div class="wrap d-prose">
  {{ m.author_block(author, updated) }}
  <div class="d-tldr"><strong>Коротко, если некогда читать</strong><p>{{ lead }}</p></div>
{% if conv %}  {{ m.pricebar(conv.anchor) }}
{% endif %}  <div class="d-toc"><strong>О чём этот материал</strong>
    <ol>
{% for s in sections %}      <li><a href="#{{ s.id }}">{{ s.h }}</a></li>
{% endfor %}    </ol>
  </div>

{% for s in sections %}
  <h2 class="d-sh" id="{{ s.id }}">{{ s.h }}</h2>
{{ m.blocks(s) }}
{% if loop.index == cta_after %}{{ m.midcta(cfg, cta_head2 or cta_head, cta_text2 or cta_text) }}{% endif %}
{% endfor %}
{{ m.photos(photos, photos_head, photos_intro) }}
{% if conv %}{{ m.order_block(cfg, conv.head, conv.rows, order_steps, price_note, conv.note) }}
{% endif %}{% if calc %}{{ m.calculator(cfg, calc) }}
{% endif %}{# Завершающий призыв в конце статьи убран: сразу за ней стоит
   тёмная полоса быстрой заявки, и два призыва подряд были бы дублем. #}
</div></section>

{{ m.deliveries(fleet_photos) }}

{{ m.quick_band(cfg, cta_head, cta_text, subject) }}

{{ m.guarantee_band(g.guarantees, g.trust) }}

{% if commercial %}{{ m.steps_band(order_head, [
    "Скажите материал и объём в кубах. Не знаете объём: назовите размеры участка работ, посчитаем сами.",
    "Назовите адрес и опишите заезд: ширина ворот, место для разворота и подъёма кузова.",
    "Получите точную цену с доставкой. " ~ cfg.callback_promise|capitalize ~ ", на месте сумма не меняется.",
    "Принимаете машину на объекте и проверяете объём. " ~ cfg.payment]) }}
{% endif %}

{{ m.form_band(cfg, form_head, subject) }}

{{ m.msg_card(cfg) }}

<section class="d-band"><div class="wrap">
  {{ m.objections(objections, None,
     "Самосвалы от 5 до 20 кубов по " ~ cfg.region_dat ~ ". Разгрузка на объекте, оплата после выгрузки, " ~ cfg.callback_promise ~ ".") }}
</div></section>

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.sh("Частые вопросы", "faq") }}
  {{ m.faq(faq) }}
</div></section>

<section class="d-band"><div class="wrap">
  {{ m.chips(related_links, "Смотрите также") }}
</div></section>
{% endblock %}
