{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block body %}
<section class="d-hero"><div class="wrap">
  <h1>{{ h1 }}</h1>
  <p>{{ hero_sub }}</p>
  <div class="d-cta-row">
    <a class="d-btn" href="{{ cfg.phone_href }}" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','call')}catch(e){}">Позвонить {{ cfg.phone }}</a>
    <a class="d-btn d-btn-ghost" href="#zayavka">Рассчитать заявку</a>
  </div>
</div></section>

<section><div class="wrap d-prose">
  {{ m.author_block(author, updated) }}
  <div class="d-tldr"><strong>Коротко, если некогда читать</strong><p>{{ lead }}</p></div>
  <div class="d-toc"><strong>О чём этот материал</strong>
    <ol>
{% for s in sections %}      <li><a href="#{{ s.id }}">{{ s.h }}</a></li>
{% endfor %}    </ol>
  </div>

{% for s in sections %}
  <h2 id="{{ s.id }}">{{ s.h }}</h2>
{{ m.blocks(s) }}
{% if loop.index == cta_after %}{{ m.midcta(cfg, cta_head, cta_text) }}{% endif %}
{% endfor %}
</div></section>

<section class="d-dark-sec"><div class="wrap">
  <h2>Как мы возим</h2>
  <p>Самосвалы от 5 до 20 кубов по {{ cfg.region_dat }}. Разгрузка на объекте, оплата после выгрузки, {{ cfg.callback_promise }}.</p>
  {{ m.advantages(advantages) }}
</div></section>

<section id="zayavka"><div class="wrap d-two">
  <div>{{ m.callblock(cfg) }}</div>
  <div>
    <h2>{{ form_head }}</h2>
    {{ m.lead_form(cfg, subject) }}
  </div>
</div></section>

<section><div class="wrap">
  <h2>Частые вопросы</h2>
  {{ m.faq(faq) }}
</div></section>

<section><div class="wrap">
  {{ m.related(related_links) }}
</div></section>
{% endblock %}
