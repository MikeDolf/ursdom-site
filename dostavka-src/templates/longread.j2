{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block body %}
<section class="d-hero" style="--cell:{{ hero_cell|default(34) }}px"><div class="wrap d-hero-grid">
  <div class="d-hero-main">
  <h1>{{ h1 }}</h1>
  <p>{{ hero_sub }}</p>
  <div class="d-cta-row">
    <a class="d-btn d-btn-max" href="{{ cfg.max_url }}" target="_blank" rel="noopener" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','{{ cfg.goal_contact }}')}catch(e){}">Написать в MAX</a>
    <a class="d-btn d-btn-ghost" href="#zayavka">Рассчитать заявку</a>
  </div>
  </div>
  {{ m.hero_panel(hero_frac|default("щебень 20-40 мм")) }}
</div></section>

<section><div class="wrap d-prose">
{% if commercial %}
  <h2 id="ceny">{{ price_head }}</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ price_note }}</caption>
    <thead><tr><th>Материал</th><th>Цена за куб, руб</th></tr></thead>
    <tbody>
{% for name,price in per_cube %}      <tr><td>{{ name }}</td><td>{{ price }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
  <p class="d-note">{{ delivery_note }}</p>

  <h2 id="kak-zakazat">{{ order_head }}</h2>
  <ol class="d-steps">
    <li>Скажите материал и объём в кубах. Не знаете объём: назовите размеры участка работ, посчитаем сами.</li>
    <li>Назовите адрес и опишите заезд: ширина ворот, место для разворота и подъёма кузова.</li>
    <li>Получите точную цену с доставкой. {{ cfg.callback_promise|capitalize }}, на месте сумма не меняется.</li>
    <li>Принимаете машину на объекте и проверяете объём. {{ cfg.payment }}</li>
  </ol>

  {{ m.midcta(cfg, cta_head, cta_text) }}
{% endif %}
  {{ m.author_block(author, updated) }}
  <div class="d-tldr"><strong>Коротко, если некогда читать</strong><p>{{ lead }}</p></div>
{% if conv %}  {{ m.pricebar(conv.anchor) }}
{% endif %}  <div class="d-toc"><strong>О чём этот материал</strong>
    <ol>
{% for s in sections %}      <li><a href="#{{ s.id }}">{{ s.h }}</a></li>
{% endfor %}    </ol>
  </div>

{% for s in sections %}
  <h2 id="{{ s.id }}">{{ s.h }}</h2>
{{ m.blocks(s) }}
{% if loop.index == cta_after %}{{ m.midcta(cfg, cta_head2 or cta_head, cta_text2 or cta_text) }}{% endif %}
{% endfor %}
{% if conv %}{{ m.order_block(cfg, conv.head, conv.rows, order_steps, price_note) }}
  {{ m.midcta(cfg, cta_head, cta_text) }}
{% endif %}</div></section>

<section class="d-dark-sec"><div class="wrap">
  <h2>Как мы возим</h2>
  <p>Самосвалы от 5 до 20 кубов по {{ cfg.region_dat }}. Разгрузка на объекте, оплата после выгрузки, {{ cfg.callback_promise }}.</p>
  {{ m.advantages(advantages) }}
</div></section>

<section id="zayavka"><div class="wrap d-two">
  <div>{{ m.callblock(cfg) }}</div>
  <div>
    <h2>{{ form_head }}</h2>
    {{ m.lead_form(cfg, subject) }}
  </div>
</div></section>

<section><div class="wrap">
  {{ m.objections(objections) }}
</div></section>

<section><div class="wrap">
  <h2>Частые вопросы</h2>
  {{ m.faq(faq) }}
</div></section>

<section><div class="wrap">
  {{ m.related(related_links) }}
</div></section>
{% endblock %}
