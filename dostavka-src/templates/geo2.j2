{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{# Порядок и устройство блоков по образцу владельца, как в geoplus.j2:
   цена машины, калькулятор, фото доставок, быстрая заявка, гарантии,
   почему мы, как заказать, форма, «проще написать», доставка в город
   и машины, потом текст про плечо, грунты и материалы, полный прайс,
   ссылки и частые вопросы. #}
{% block fleet %}{% endblock %}
{% block body %}
{{ m.hero2(h1, hero_sub, bg=hero_bg, price=hero_price,
           price_unit="руб за куб щебня 20-40, доставка " ~ city.prep ~ " по плечу " ~ plecho_km ~ " км",
           note="Оплата после выгрузки, объём проверяете по кузову до разгрузки", cfg=cfg, third_href=("#kalkulyator" if calc else "#zayavka"), third_text=("Посчитать в калькуляторе" if calc else "Узнать цену с доставкой")) }}

{% if lots %}
<section class="d-band"><div class="wrap">
  {{ m.sh("Сколько стоит машина " ~ city.prep, "skolko-mashina", p_percube) }}
  <div class="d-lotcards">
{% for r in lots %}    <div class="d-lotcard">
      <span class="d-lotcard-vol">{{ r.vol }} м³</span>
      <b>{{ r.total }} <small>руб</small></b>
      <span>{{ r.truck }}: щебень 20-40 {{ r.material }} руб и доставка {{ r.delivery }} руб</span>
    </div>
{% endfor %}  </div>
  <p class="d-note">Предварительный расчёт для плеча {{ plecho_km }} км, точную сумму называем по заявке.
  {{ lots_note }} Другой материал и объём посчитает <a href="/dostavka/kalkulyator/shcheben/">калькулятор щебня</a>,
  там же объём по размерам площадки.</p>
</div></section>
{% endif %}

{% if calc %}<section class="d-band d-band-tint"><div class="wrap">
{{ m.calculator(cfg, calc) }}
</div></section>
{% endif %}

{{ m.form_band(cfg, "Заявка на доставку " ~ city.prep, "доставка, " ~ city.name) }}

{{ m.deliveries(fleet_photos) }}

{{ m.guarantee_band(g.guarantees, g.trust) }}

{{ m.why_band(g.why, g.stats, cfg) }}

{{ m.steps_band("Как заказать доставку " ~ city.prep, [
    "Скажите материал и объём в кубах. Не знаете объём: назовите размеры площадки или фундамента, посчитаем сами.",
    "Назовите адрес " ~ city.loc ~ " и опишите заезд: ширина ворот, есть ли где развернуться и поднять кузов.",
    "Получите точную цену с доставкой. " ~ cfg.callback_promise|capitalize ~ " и согласуем окно приезда.",
    "Принимаете машину на объекте, проверяете объём. " ~ cfg.payment], p_minv) }}

<section class="d-band"><div class="wrap">
  {{ m.sh("Доставка " ~ city.prep, "dostavka") }}
  {{ m.info_cards(info, info_note) }}
</div></section>

{{ m.trucks(trucks) }}

<section class="d-band"><div class="wrap d-prose">
  <h2 class="d-sh" id="plecho">Сколько везти {{ city.prep }} и что это значит для цены</h2>
  <p>{{ p_plecho }}</p>
{% if city.note %}  <div class="d-callout"><p><strong>Важно по этому адресу:</strong> {{ city.note }}</p></div>
{% endif %}
  <p>{{ p_econ }}</p>

  {# Заголовок был дословно одинаков на всех 32 гео-страницах. Теперь
     в него уходит грунт конкретного города: именная группа ставится
     после двоеточия, где именительный падеж грамматичен. #}
  <h2 class="d-sh" id="mestnoe">Местные особенности {{ city.loc }}: {{ ground_tag }}</h2>
  <p>{{ p_local }}</p>
  <h2 class="d-sh" id="materialy">Что возим {{ city.prep }}</h2>
  <p>По каждому материалу ниже: где он здесь работает, ходовые фракции
  и разобранный расчёт объёма на типовой задаче.</p>

{% for b in mat_blocks %}
  <h3 id="m-{{ b.key }}">{{ b.name }} {{ city.loc }}</h3>
  <p>{{ b.task }}</p>
{% if b.note %}  <p>{{ b.note }}</p>
{% endif %}{% for g in b.ground %}  <p>{% if loop.first %}<strong>На грунтах {{ city.rod }}.</strong> {% endif %}{{ g }}</p>
{% endfor %}{% if b.fractions %}  <div class="d-table-wrap"><table>
    <caption>Ходовые фракции {{ b.rod }} и применение {{ city.loc }}</caption>
    <thead><tr><th>Фракция</th><th>Где применяют</th></tr></thead>
    <tbody>
{% for f,d in b.fractions %}      <tr><td>{{ f }}</td><td>{{ d }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}
  <p><strong>Расчёт на примере.</strong> {{ b.ex.task|capitalize }} размером {{ b.ex.dims }},
  это {{ b.ex.area }} м², слой {{ b.ex.matname }} толщиной
  {{ b.ex.thick }} см. По геометрии выходит {{ b.ex.geom }} м³,
  с коэффициентом уплотнения {{ b.ex.k }} это {{ b.ex.real }} м³.
  {{ b.ex.note }} На плече {{ dist }} такой объём везёт {{ b.ex.truck }}.</p>
  <p class="d-note">Подробнее про виды и цены: <a href="{{ b.url }}">{{ b.name }} с доставкой по области</a>.</p>
{% endfor %}
  <h2 class="d-sh" id="grunt">{{ h_grunt }}</h2>
  <p>{{ p_grunt }}</p>

  {# Второй из двух одинаковых заголовков: привязываем к городу
     и к тракту, по которому сюда реально идёт рейс. #}
  <h2 class="d-sh" id="sroki">Сроки {{ city.loc }}: рейс по {{ city.tract }}</h2>
  <p>{{ p_sroki }}</p>

</div></section>

<section class="d-band d-band-tint"><div class="wrap">
  <h2 class="d-sh" id="ceny">Цены на все материалы {{ city.loc }} с доставкой</h2>
  <div class="d-table-wrap"><table{% if per_cube_trip %} class="d-trip"{% endif %}>
    <caption>{{ price_note }} Итоговая цена {{ city.prep }} зависит от плеча ({{ dist }}) и объёма машины.{% if per_cube_trip %} Последний столбец: предварительная сумма за машину на {{ trip_vol }} м³ с доставкой {{ city.prep }}.{% endif %}</caption>
{% if per_cube_trip %}    <thead><tr><th>Материал</th><th>За куб, руб</th><th>{{ trip_vol }} м³ с доставкой, руб</th></tr></thead>
    <tbody>
{% for name,price,trip in per_cube_trip %}      <tr><td>{{ name }}</td><td>{{ price }}</td><td class="d-spec-val">{{ trip }}</td></tr>
{% endfor %}    </tbody>
{% else %}    <thead><tr><th>Материал</th><th>Цена за куб, руб</th></tr></thead>
    <tbody>
{% for name,price in per_cube %}      <tr><td>{{ name }}</td><td>{{ price }}</td></tr>
{% endfor %}    </tbody>
{% endif %}
  </table></div>
  <p class="d-note">{{ delivery_note }}</p>

</div></section>

<section class="d-band"><div class="wrap">
  {{ m.chips(related_links, "Ещё по теме и в соседних городах") }}
</div></section>

{{ m.msg_card(cfg) }}

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.sh("Частые вопросы о доставке " ~ city.prep, "faq") }}
  {{ m.faq(faq) }}
</div></section>
{% endblock %}
