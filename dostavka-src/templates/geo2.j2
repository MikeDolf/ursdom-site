{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block body %}
<section class="d-hero" style="--cell:{{ hero_cell|default(34) }}px"><div class="wrap d-hero-grid">
  <div class="d-hero-main">
  <h1>{{ h1 }}</h1>
  <p>{{ hero_sub }}</p>
  {{ m.channels(cfg, "#zayavka", "Узнать цену с доставкой") }}
  </div>
  {{ m.hero_panel(hero_cap|default("щебень 20-40 мм", true), hero_img|default(none, true)) }}
</div></section>

<section><div class="wrap d-prose">
  <h2 id="ceny">Цены на щебень и песок {{ city.loc }} с доставкой</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ price_note }} Итоговая цена {{ city.prep }} зависит от плеча ({{ dist }}) и объёма машины.</caption>
    <thead><tr><th>Материал</th><th>Цена за куб, руб</th></tr></thead>
    <tbody>
{% for name,price in per_cube %}      <tr><td>{{ name }}</td><td>{{ price }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
  <p class="d-note">{{ delivery_note }}</p>

  <h2 id="plecho">Сколько везти {{ city.prep }} и что это значит для цены</h2>
  <p>{{ p_plecho }}</p>
{% if city.note %}  <div class="d-callout"><p><strong>Важно по этому адресу:</strong> {{ city.note }}</p></div>
{% endif %}
  <p>{{ p_econ }}</p>

  {{ m.midcta(cfg, "Посчитаем объём и цену за 15 минут", "Назовите задачу и адрес " + city.loc + ", подберём материал и машину под ваш заезд, назовём итоговую сумму с доставкой.") }}

  <h2 id="kuda">Куда возим {{ city.prep }} и в округ</h2>
  <p>{{ p_kuda }}</p>

  {# Заголовок был дословно одинаков на всех 32 гео-страницах. Теперь
     в него уходит грунт конкретного города: именная группа ставится
     после двоеточия, где именительный падеж грамматичен. #}
  <h2 id="mestnoe">Местные особенности {{ city.loc }}: {{ ground_tag }}</h2>
  <p>{{ p_local }}</p>
</div></section>

<section><div class="wrap d-prose">
  <h2 id="materialy">Что возим {{ city.prep }}</h2>
  <p>По каждому материалу ниже: где он здесь работает, ходовые фракции
  и разобранный расчёт объёма на типовой задаче.</p>

{% for b in mat_blocks %}
  <h3 id="m-{{ b.key }}">{{ b.name }} {{ city.loc }}</h3>
  <p>{{ b.task }}</p>
{% if b.fractions %}  <div class="d-table-wrap"><table>
    <caption>Ходовые фракции {{ b.rod }} и применение {{ city.loc }}</caption>
    <thead><tr><th>Фракция</th><th>Где применяют</th></tr></thead>
    <tbody>
{% for f,d in b.fractions %}      <tr><td>{{ f }}</td><td>{{ d }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}
  <p><strong>Расчёт на примере.</strong> {{ b.ex.task|capitalize }} размером {{ b.ex.dims }},
  это {{ b.ex.area }} квадратных метров, слой {{ b.ex.matname }} толщиной
  {{ b.ex.thick }} сантиметров. По геометрии выходит {{ b.ex.geom }} кубометра,
  с коэффициентом уплотнения {{ b.ex.k }} это {{ b.ex.real }} кубометра.
  {{ b.ex.note }} На плече {{ dist }} такой объём везёт {{ b.ex.truck }}.</p>
  <p class="d-note">Подробнее про виды и цены: <a href="{{ b.url }}">{{ b.name }} с доставкой по области</a>.</p>
{% endfor %}
</div></section>

<section><div class="wrap d-prose">
  <h2 id="grunt">Грунты {{ city.loc }} и что из этого следует</h2>
  <p>{{ p_grunt }}</p>

  {# Второй из двух одинаковых заголовков: привязываем к городу
     и к тракту, по которому сюда реально идёт рейс. #}
  <h2 id="sroki">Сроки {{ city.loc }}: рейс по {{ city.tract }}</h2>
  <p>{{ p_sroki }}</p>

  <h2 id="kak-zakazat">Как заказать доставку {{ city.prep }}</h2>
  <ol class="d-steps">
    <li>Скажите материал и объём в кубах. Не знаете объём: назовите размеры площадки или фундамента, посчитаем сами.</li>
    <li>Назовите адрес {{ city.loc }} и опишите заезд: ширина ворот, есть ли где развернуться и поднять кузов.</li>
    <li>Получите точную цену с доставкой. {{ cfg.callback_promise|capitalize }} и согласуем окно приезда.</li>
    <li>Принимаете машину на объекте, проверяете объём. {{ cfg.payment }}</li>
  </ol>
  <p class="d-note">{{ p_minv }}</p>
</div></section>

<section class="d-dark-sec"><div class="wrap">
  <h2>Почему с нами спокойнее</h2>
  {{ m.guarantees(guarantees) }}
</div></section>

<section id="zayavka"><div class="wrap">
  <h2>Оставить заявку</h2>
  <div class="d-two">
  <div>{{ m.callblock(cfg) }}</div>
  <div>
    <h3>Заявка на доставку {{ city.prep }}</h3>
    {{ m.lead_form(cfg, "доставка, " + city.name) }}
  </div>
  </div>
</div></section>

<section><div class="wrap">
  <h2>Частые вопросы о доставке {{ city.prep }}</h2>
  {{ m.faq(faq) }}
</div></section>

<section><div class="wrap">
  {{ m.related(related_links) }}
</div></section>
{% endblock %}
