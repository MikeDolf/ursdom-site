{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block fleet %}{% endblock %}
{% block body %}
{{ m.hero2(h1, hero_sub, bg=hero_img, bg_alt=(hero_cap ~ ", фотография материала") if hero_cap else None,
           price=hero_price, cfg=cfg, third_href="#obem", third_text="Посчитать объём") }}

{% if quick %}
<nav class="d-quick" aria-label="Другие калькуляторы"><div class="wrap">
  <span class="d-quick-lab">Считаем ещё</span>
{% for label, href in quick %}  <a href="{{ href }}">{{ label }}</a>
{% endfor %}</div></nav>
{% endif %}

<section class="d-band"><div class="wrap">
  {{ m.volcalc(cfg, vc) }}
</div></section>

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.tonscalc(vc) }}
</div></section>

{% if calc %}
<section class="d-band"><div class="wrap">
  {{ m.calculator(cfg, calc) }}
</div></section>
{% endif %}

{{ m.deliveries(fleet_photos) }}

{{ m.guarantee_band(g.guarantees, g.trust) }}

{{ m.form_band(cfg, "Заявка на " ~ mat_order, subject, head="Посчитаем под ваш объект") }}

{{ m.msg_card(cfg) }}

<section class="d-band"><div class="wrap d-prose">
  {{ m.sh("Как мы считаем", "metodika") }}
{% for h, p in method %}  <h3>{{ h }}</h3>
{% for line in p %}  <p>{{ line }}</p>
{% endfor %}{% endfor %}
</div></section>

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.sh("Частые вопросы о расчёте", "faq") }}
  {{ m.faq(faq) }}
</div></section>

<section class="d-band"><div class="wrap">
  {{ m.chips(related_links, "Смотрите также") }}
</div></section>
{% endblock %}
