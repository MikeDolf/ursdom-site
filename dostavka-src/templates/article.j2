{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block body %}
<section><div class="wrap">
  <h1>{{ h1 }}</h1>
  <p class="d-note">Автор: {{ author.name }}, {{ author.role }}</p>
  <p><strong>Коротко.</strong> {{ lead }}</p>
{% for htext,body in sections %}
  <h2>{{ htext }}</h2>
  <p>{{ body }}</p>
{% endfor %}
</div></section>

<section class="d-dark-sec"><div class="wrap">
  <h2>Нужен материал с доставкой?</h2>
  <p>Привезём щебень и песок по {{ cfg.region }} самосвалами от 5 до 20 кубов, оплата после выгрузки.</p>
  <div class="d-cta-row">
    <a class="d-btn" href="{{ cfg.phone_href }}" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','call')}catch(e){}">Позвонить {{ cfg.phone }}</a>
    <a class="d-btn d-btn-max" href="{{ cfg.max_url }}" target="_blank" rel="noopener">Написать в MAX</a>
  </div>
</div></section>

<section><div class="wrap">
  <h2>Частые вопросы</h2>
  {{ m.faq(faq) }}
</div></section>

<section><div class="wrap">
  {{ m.related(related_links) }}
</div></section>
{% endblock %}
