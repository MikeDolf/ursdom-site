{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{# Старый шаблон щебня по городу, на нём остался Среднеуральск. Порядок
   блоков тот же, что у geoplus.j2 и geo2.j2 (по образцу владельца). #}
{% block fleet %}{% endblock %}
{% block body %}
{{ m.hero2(h1, hero_sub, bg=hero_bg, price=hero_price,
           price_unit="руб за куб щебня 20-40, доставка считается по плечу",
           note="Оплата после выгрузки, объём проверяете по кузову до разгрузки", cfg=cfg, third_href=("#kalkulyator" if calc else "#zayavka"), third_text=("Посчитать в калькуляторе" if calc else "Узнать цену с доставкой")) }}

{% if lots %}
<section class="d-band"><div class="wrap">
  {{ m.sh("Сколько стоит машина " ~ city.prep, "skolko-mashina") }}
  <div class="d-lotcards">
{% for r in lots %}    <div class="d-lotcard">
      <span class="d-lotcard-vol">{{ r.vol }} м³</span>
      <b>{{ r.total }} <small>руб</small></b>
      <span>{{ r.truck }}: щебень 20-40 {{ r.material }} руб и доставка {{ r.delivery }} руб</span>
    </div>
{% endfor %}  </div>
  <p class="d-note">Предварительный расчёт для плеча {{ plecho_km }} км, точную сумму называем по заявке.
  {{ lots_note }} Другой материал и объём посчитает <a href="/dostavka/kalkulyator/shcheben/">калькулятор щебня</a>.</p>
</div></section>
{% endif %}

{{ m.form_band(cfg, "Заявка на доставку " ~ city.prep, "доставка, " ~ city.name) }}

{{ m.deliveries(fleet_photos) }}

{{ m.guarantee_band(g.guarantees, g.trust) }}

{{ m.why_band(g.why, g.stats, cfg) }}

{{ m.steps_band("Как заказать доставку " ~ city.prep, [
    "Скажите фракцию и объём в кубах. Не знаете объём: назовите размеры площадки или фундамента, посчитаем сами.",
    "Назовите адрес " ~ city.loc ~ " и опишите заезд: ширина ворот, есть ли где развернуться и поднять кузов.",
    "Получите точную цену с доставкой. " ~ cfg.callback_promise|capitalize ~ " и согласуем окно приезда.",
    "Принимаете машину на объекте, проверяете объём и фракцию. " ~ cfg.payment]) }}

{{ m.trucks(trucks) }}

<section class="d-band"><div class="wrap d-prose">
  <h2 class="d-sh" id="plecho">Доставка щебня {{ city.prep }}: плечо и цена</h2>
  <p>{{ city.block }}</p>

  <h2 class="d-sh" id="kuda">Куда возим {{ city.prep }} и в район</h2>
  <p>{{ city.areas }}</p>

  <h2 class="d-sh" id="chto">Что чаще заказывают {{ city.loc }}</h2>
  <p>{{ city.use }}</p>

  <h2 class="d-sh" id="sroki">Сроки и какая машина приедет</h2>
  <p>{{ city.terms }}</p>

  <h2 class="d-sh" id="obekty">Типовые объекты {{ city.loc }}</h2>
  <p>{{ city.objects }}</p>
</div></section>

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.sh("Цены на щебень " ~ city.loc, "ceny") }}
  <div class="d-table-wrap"><table>
    <caption>{{ price_note }} Итоговая цена с доставкой {{ city.prep }} зависит от расстояния ({{ city.dist }}) и объёма машины.</caption>
    <thead><tr><th>Материал</th><th>Цена за куб, руб</th></tr></thead>
    <tbody>
{% for name,price in per_cube %}      <tr><td>{{ name }}</td><td>{{ price }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
  <p class="d-note">{{ delivery_note }}</p>
</div></section>

<section class="d-band"><div class="wrap">
  {{ m.chips(related_links, "Ещё по теме и в соседних городах") }}
</div></section>

{{ m.buyers(buyers|default([], true), buyers_head) }}

{{ m.msg_card(cfg) }}

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.sh("Частые вопросы о доставке " ~ city.prep, "faq") }}
  {{ m.faq(faq) }}
</div></section>
{% endblock %}
