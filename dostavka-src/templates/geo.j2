{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block body %}
<section class="d-hero" style="--cell:{{ hero_cell|default(34) }}px"><div class="wrap d-hero-grid">
  <div class="d-hero-main">
  <h1>{{ h1 }}</h1>
  <p>{{ hero_sub }}</p>
  {{ m.channels(cfg, "#zayavka", "Узнать цену с доставкой") }}
  </div>
  {{ m.hero_panel(hero_cap|default("щебень 20-40 мм", true), hero_img|default(none, true)) }}
</div></section>

<section><div class="wrap d-prose">
  <h2 id="ceny">Цены на щебень {{ city.loc }}</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ price_note }} Итоговая цена с доставкой {{ city.prep }} зависит от расстояния ({{ city.dist }}) и объёма машины.</caption>
    <thead><tr><th>Материал</th><th>Цена за куб, руб</th></tr></thead>
    <tbody>
{% for name,price in per_cube %}      <tr><td>{{ name }}</td><td>{{ price }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
  <p class="d-note">{{ delivery_note }}</p>

  <h2 id="kak-zakazat">Как заказать доставку {{ city.prep }}</h2>
  <ol class="d-steps">
    <li>Скажите фракцию и объём в кубах. Не знаете объём: назовите размеры площадки или фундамента, посчитаем сами.</li>
    <li>Назовите адрес {{ city.loc }} и опишите заезд: ширина ворот, есть ли где развернуться и поднять кузов.</li>
    <li>Получите точную цену с доставкой. {{ cfg.callback_promise|capitalize }} и согласуем окно приезда.</li>
    <li>Принимаете машину на объекте, проверяете объём и фракцию. {{ cfg.payment }}</li>
  </ol>

  {{ m.midcta(cfg, "Посчитаем объём и цену за 15 минут", "Назовите задачу и адрес " + city.loc + ", подберём фракцию и машину под ваш заезд, назовём итоговую сумму с доставкой.") }}
</div></section>

<section><div class="wrap d-prose">
  <h2 id="plecho">Доставка щебня {{ city.prep }}: плечо и цена</h2>
  <p>{{ city.block }}</p>

  <h2 id="kuda">Куда возим {{ city.prep }} и в район</h2>
  <p>{{ city.areas }}</p>

  <h2 id="chto">Что чаще заказывают {{ city.loc }}</h2>
  <p>{{ city.use }}</p>

  <h2 id="sroki">Сроки и какая машина приедет</h2>
  <p>{{ city.terms }}</p>

  <h2 id="obekty">Типовые объекты {{ city.loc }}</h2>
  <p>{{ city.objects }}</p>
</div></section>

<section class="d-dark-sec"><div class="wrap">
  <h2>Почему с нами спокойнее</h2>
  {{ m.guarantees(guarantees) }}
</div></section>

<section id="zayavka"><div class="wrap">
  <h2>Оставить заявку</h2>
  <div class="d-two">
  <div>{{ m.callblock(cfg) }}</div>
  <div>
    <h3>Заявка на доставку {{ city.prep }}</h3>
    {{ m.lead_form(cfg, "щебень, "+city.name) }}
  </div>
  </div>
</div></section>

<section><div class="wrap">
  <h2>Частые вопросы о доставке {{ city.prep }}</h2>
  {{ m.faq(faq) }}
</div></section>

<section><div class="wrap">
  {{ m.related(related_links) }}
</div></section>
{% endblock %}
