{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block body %}
<section class="d-hero"><div class="wrap">
  <h1>{{ h1 }}</h1>
  <p>{{ hero_sub }}</p>
  <div class="d-cta-row">
    <a class="d-btn" href="{{ cfg.phone_href }}" onclick="try{ym({{ cfg.metrika_id }},'reachGoal','call')}catch(e){}">Позвонить {{ cfg.phone }}</a>
    <a class="d-btn d-btn-ghost" href="#zayavka">Рассчитать заявку</a>
  </div>
</div></section>

<section><div class="wrap">
  <p>{{ intro }}</p>

  <h2>Виды {{ mat_gen }}</h2>
  <div class="d-grid">
{% for t,d in types %}    <div class="d-card"><strong>{{ t }}</strong><p>{{ d }}</p></div>
{% endfor %}  </div>
{% if fractions %}
  <h2>Фракции и применение</h2>
  <div class="d-table-wrap"><table>
    <caption>Какая фракция щебня под какую задачу</caption>
    <thead><tr><th>Фракция</th><th>Где применяют</th></tr></thead>
    <tbody>
{% for f,use in fractions %}      <tr><td>{{ f }}</td><td>{{ use }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}
</div></section>

<section class="d-dark-sec"><div class="wrap">
  <h2>Условия доставки</h2>
  <p>Возим самосвалами от 5 до 20 кубов по {{ cfg.region }}. Чем больше объём за машину, тем ниже цена за куб. Разгрузка на объекте, оплата после выгрузки.</p>
  {{ m.advantages(advantages) }}
</div></section>

<section><div class="wrap">
  <h2>Ориентировочные цены</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ price_note }}</caption>
    <thead><tr><th>Материал</th><th>Цена за куб, руб</th></tr></thead>
    <tbody>
{% for name,price in per_cube %}      <tr><td>{{ name }}</td><td>{{ price }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
  <p class="d-note">{{ delivery_note }}</p>
</div></section>

<section id="zayavka"><div class="wrap d-two">
  <div>{{ m.callblock(cfg) }}</div>
  <div>
    <h2>Заявка на {{ mat_acc }}</h2>
    {{ m.lead_form(cfg, subject) }}
  </div>
</div></section>

<section><div class="wrap">
  <h2>Частые вопросы</h2>
  {{ m.faq(faq) }}
</div></section>

<section><div class="wrap">
  {{ m.related(related_links) }}
</div></section>
{% endblock %}
