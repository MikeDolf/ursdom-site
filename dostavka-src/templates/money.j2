{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block body %}
<section class="d-hero" style="--cell:{{ hero_cell|default(34) }}px"><div class="wrap d-hero-grid">
  <div class="d-hero-main">
  <h1>{{ h1 }}</h1>
  <p>{{ hero_sub }}</p>
  {# Цена в первом экране. Раньше первое число появлялось только
     в таблице ниже, и до него надо было доскроллить: человек, зашедший
     узнать порядок цен, уходил раньше. Значение считается из той же
     таблицы (hero_price_for в build.py), поэтому разойтись с ней
     не может. #}
{% if hero_price %}  <p class="d-hero-price"><b>{{ hero_price }}</b><span>руб за куб, доставка считается отдельно</span></p>
{% endif %}
  {{ m.channels(cfg, "#zayavka", "Рассчитать заявку") }}
  </div>
  {{ m.hero_panel(hero_cap|default("щебень 20-40 мм", true), hero_img|default(none, true)) }}
</div></section>

{# Быстрые ссылки. Человек с готовым запросом («мне нужен 20-40»)
   уходит к нужной странице в один клик, не читая всё подряд. Стоят
   сразу под первым экраном: ниже по странице их уже не ищут.
   Ведут только на существующие адреса и на якоря этой же страницы. #}
{% if quick %}
<nav class="d-quick" aria-label="Частые запросы"><div class="wrap">
  <span class="d-quick-lab">Чаще всего ищут</span>
{% for label, href in quick %}  <a href="{{ href }}">{{ label }}</a>
{% endfor %}</div></nav>
{% endif %}

{# Содержание страницы.
   Товарная страница выросла до двадцати разделов и двух с половиной тысяч
   слов, и человеку, пришедшему за одним конкретным ответом - «а в мешках
   возите?» - приходилось прокручивать её целиком. Полоса быстрых ссылок
   выше отвечает на частые запросы, но не показывает, что на странице
   есть вообще.

   Список собирается теми же условиями, что и сами разделы, поэтому
   пункта на несуществующий блок в нём быть не может. #}
{% set toc = [("ceny", "Цены и наличие")]
   + ([("obemy", "Готовые объёмы с доставкой")] if lots else [])
   + ([("karyery", "Карьеры и происхождение")] if quarries else [])
   + ([("pod-zadachu", "Что взять под задачу")] if tasks else [])
   + [("kak-zakazat", "Порядок заказа")]
   + ([("foto", "Как выглядит на самом деле")] if photos and photos_head else [])
   + [("vidy", "Виды и чем отличаются")]
   + ([("frakcii", "Размер зерна и применение")] if fractions else [])
   + ([("fasovka", "Фасовка: навал, мешки, биг-бэги")] if packs else [])
   + ([("harakteristiki", "Числовые характеристики")] if specs else [])
   + [("skolko", "Сколько нужно на типовые задачи")]
   + ([("kalkulyator", "Калькулятор доставки")] if calc else [])
   + [("oplata", "Способы оплаты"), ("zony", "Зоны доставки и города"),
      ("zayavka", "Оставить заявку"), ("faq", "Частые вопросы")] %}
<section><div class="wrap d-prose">
  <nav class="d-toc" aria-label="Содержание страницы"><strong>Что на этой странице</strong>
    <ol>
{% for id, label in toc %}      <li><a href="#{{ id }}">{{ label }}</a></li>
{% endfor %}    </ol>
  </nav>
</div></section>

{# Прайс витриной, а не таблицей. Строки те же и цены те же, но у каждой
   появились снимок, применение одной фразой и кнопка заказа. Первыми
   идут позиции материала этой страницы, остальные работают
   перекрёстной продажей.

   Стоит в обёртке без d-prose намеренно: колонка текста шириной 70ch
   разворачивает сетку карточек в две колонки вместо четырёх и оставляет
   треть широкого экрана пустой. Это сетка, а не проза. #}
<section><div class="wrap">
  {{ m.shelf(shelf_rows, "Цены на " ~ mat_vin ~ " с доставкой", price_note) }}
  <p class="d-note">{{ delivery_note }}</p>
</div></section>

<section><div class="wrap d-prose">
{# Готовые объёмы с доставкой. Таблица выше даёт цену материала
   самовывозом, а человеку нужна сумма «под ключ»: он спрашивает
   не «сколько стоит куб», а «сколько стоит машина щебня».
   Закрывает запросы вида «щебень 10 кубов цена». #}
{% if lots %}
  <h2 id="obemy">{{ lots_head }}</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ lots_note }}</caption>
    <thead><tr><th>Объём</th><th>20-40, 40-70, 70-120</th><th>5-20</th><th>Какой заказ закрывает</th></tr></thead>
    <tbody>
{% for vol, p1, p2, note in lots %}      <tr><td class="d-spec-val">{{ vol }}</td><td class="d-spec-val">{{ p1 }} руб</td><td class="d-spec-val">{{ p2 }} руб</td><td>{{ note }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}

{# Песок по карьерам. Стоит вплотную к цене, потому что отвечает
   на вопрос, который цена и порождает: почему у одного песка 990,
   а у другого 1200, и что я за эту разницу получаю.

   Колонка с единицей обязательна: мытый песок на этом рынке продают
   тоннами, карьерный кубами. Без неё человек читает 990 как цену куба
   и планирует бюджет в полтора раза меньше реального.

   Блок необязательный: материалы без ключа quarries не рендерят ничего. #}
{% if quarries %}
  <h2 id="karyery">{{ quarries_head }}</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ quarries_note }}</caption>
    <thead><tr><th>Карьер</th><th>Вид</th><th>Цена</th><th>Чем отличается</th></tr></thead>
    <tbody>
{% for pit, kind, price, unit, note in quarries %}      <tr><td>{{ pit }}</td><td>{{ kind }}</td><td class="d-spec-val">{{ price }}{% if unit %} <span class="d-unit">{{ unit }}</span>{% endif %}</td><td>{{ note }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}

{# Блок «под задачу» стоит сразу после цен, а не в конце страницы.
   Порядок здесь и есть суть перестройки: человек сначала видит цену,
   потом сразу получает ответ «а мне какой», и только потом читает
   про виды, характеристики и порядок заказа. Раньше этот блок был
   девятым, и до него доходили единицы.

   Заголовок третьего уровня повторяет формулировку запроса, под ним
   рабочая фракция и короткий разбор, дальше ссылка в статью по теме.
   Блок необязательный: материалы без ключа tasks не рендерят ничего. #}
{% if tasks %}
  {# mat_vin, а не выдуманный mat_name: в контексте товарной страницы
     название материала лежит в падежных формах, именительного отдельно
     нет. Для «щебень под задачу» винительный совпадает с именительным.
     default со вторым аргументом true: сборка передаёт tasks_head=None
     для материалов без своего заголовка, а односложный default ловит
     только необъявленную переменную и пропустил бы None в разметку. #}
  <h2 id="pod-zadachu">{{ tasks_head|default(mat_vin|capitalize ~ " под задачу", true) }}</h2>
  <div class="d-tasks">
{% for head, frac, text, href, link_text in tasks %}    <div class="d-task">
      <h3>{{ head }}</h3>
      <p class="d-task-frac">{{ frac }}</p>
      <p>{{ text }}</p>
{% if href %}      <p><a href="{{ href }}">{{ link_text }}</a></p>
{% endif %}    </div>
{% endfor %}  </div>
{% endif %}

{# Лента шагов тоже выходит из колонки текста: четыре колонки в 70ch
   дают по 160 пикселей на шаг, и фраза рассыпается в столбик из слов. #}
</div></section>

<section><div class="wrap">
  <h2 id="kak-zakazat">Как заказать {{ mat_order }}</h2>
  <ol class="d-steps">
    <li>Скажите вид материала и объём в кубах. Если объём неизвестен, назовите размеры участка работ и толщину слоя.</li>
    <li>Назовите адрес и опишите заезд: ширина ворот, место для разворота и подъёма кузова.</li>
    <li>Получите точную цену с доставкой. {{ cfg.callback_promise|capitalize }}.</li>
    <li>Принимаете машину на объекте и проверяете объём. {{ cfg.payment }}</li>
  </ol>
</div></section>

<section><div class="wrap d-prose">
  {{ m.midcta(cfg, "Не знаете, сколько кубов нужно?", "Назовите размеры площадки, фундамента или траншеи. Посчитаем объём с запасом на уплотнение и подберём машину под ваш заезд.") }}

  <p>{{ intro }}</p>

{{ m.photos(photos, "Как выглядит " ~ mat_vin,
   "Снимки по каждому виду и фракции: по ним видно и цвет породы, и форму зерна, и реальный размер камня относительно рулетки или монеты.") }}

  <h2 id="vidy">{{ types_head|default("Виды " ~ mat_rod) }}</h2>
  <div class="d-grid">
{% for t,d in types %}    <div class="d-card"><strong>{{ t }}</strong><p>{{ d }}</p></div>
{% endfor %}  </div>
{% if fractions %}
  <h2 id="frakcii">{{ fractions_head|default("Фракции и применение", true) }}</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ fractions_caption|default("Какая фракция " ~ mat_rod ~ " под какую задачу", true) }}</caption>
    <thead><tr><th>{{ fractions_col1|default("Фракция", true) }}</th><th>{{ fractions_col2|default("Где применяют", true) }}</th></tr></thead>
    <tbody>
{% for f,use in fractions %}      <tr><td>{% if frac_href and frac_href.get(f) %}<a href="{{ frac_href[f] }}">{{ f }}</a>{% else %}{{ f }}{% endif %}</td><td>{{ use }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}
{# Фасовка. Отдельный блок, потому что вопрос «а можно в мешках»
   возникает раньше вопроса о фракции: от ответа зависит, поедет
   ли машина вообще. Цены тут нет намеренно - фасовка считается
   по заявке, а выдуманная цифра хуже отсутствующей. #}
{% if packs %}
  <h2 id="fasovka">{{ packs_head|default("Фасовка и объём", true) }}</h2>
  <div class="d-table-wrap"><table>
    <caption>Как берут материал и сколько выходит в кубе</caption>
    <thead><tr><th>Фасовка</th><th>Объём</th><th>Цена</th><th>Когда её берут</th></tr></thead>
    <tbody>
{% for pack, vol, price, when in packs %}      <tr><td>{{ pack }}</td><td class="d-spec-val">{{ vol }}</td><td class="d-spec-val">{{ price }}</td><td>{{ when }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}
{# Числовые характеристики материала. У конкурентов на этом рынке
   в товарных карточках обычно стоит только строчка «соответствует ГОСТ»
   без единой цифры, хотя по этим числам считают объём и выбирают
   материал под нагрузку.

   Третья колонка обязательна: голое «1,10-1,30» ничего не говорит,
   а «на 10 кубов слоя заказывают 11-13» говорит всё. Числа взяты
   из наших же статей и обязаны с ними совпадать. #}
{% if specs %}
  <h2 id="harakteristiki">{{ specs_head|default("Характеристики " ~ mat_rod, true) }}</h2>
  <div class="d-table-wrap"><table>
    <caption>Числа, по которым считают объём и выбирают материал под нагрузку</caption>
    <thead><tr><th>Параметр</th><th>Значение</th><th>Что это значит на объекте</th></tr></thead>
    <tbody>
{% for param, val, note in specs %}      <tr><td>{{ param }}</td><td class="d-spec-val">{{ val }}</td><td>{{ note }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}
  <h2 id="skolko">{{ calc_head|default("Сколько нужно на типовые задачи") }}</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ calc_caption|default("Готовые расчёты с запасом на уплотнение, чтобы прикинуть объём до заявки") }}</caption>
    <thead><tr><th>{{ calc_col1|default("Задача") }}</th><th>{{ calc_col2|default("Объём с запасом") }}</th><th>{{ calc_col3|default("Машина") }}</th></tr></thead>
    <tbody>
{% for task,vol,car in calc_rows %}      <tr><td>{{ task }}</td><td>{{ vol }}</td><td>{{ car }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
  <p class="d-note">Расчёт ориентировочный: точный объём зависит от толщины слоя и плотности грунта. Посчитаем под ваш объект по размерам.</p>
{% if calc %}{{ m.calculator(cfg, calc, lots) }}{% endif %}
</div></section>

<section class="d-dark-sec"><div class="wrap">
  <h2>Условия доставки</h2>
  <p>Возим самосвалами от 5 до 20 кубов по {{ cfg.region_dat }}. Чем больше объём за машину, тем ниже цена за куб. Разгрузка на объекте, оплата после выгрузки.</p>
  {{ m.advantages(advantages) }}
</div></section>

<section><div class="wrap">
  <h2>Что мы гарантируем</h2>
  {{ m.guarantees(guarantees) }}
</div></section>

{# Оплата и зоны стоят перед формой, а не после неё. Оба блока снимают
   возражения, с которыми человек к форме и не подходит: «а вдруг
   потребуют предоплату» и «а ко мне вообще поедут». После формы
   они бы отвечали тому, кто уже ушёл. #}
<section><div class="wrap">
  <h2 id="oplata">Как можно заплатить</h2>
  {{ m.payways(payment) }}
  {{ m.zones(zones, "Куда возим " ~ mat_vin,
     "Плечо доставки считается от Екатеринбурга и заметно влияет на цену за куб: чем дальше, тем выгоднее брать больший объём за одну машину. Города со ссылками имеют свою страницу с условиями.") }}
</div></section>

<section id="zayavka"><div class="wrap">
  <h2>Оставить заявку</h2>
  <div class="d-two">
  <div>{{ m.callblock(cfg) }}</div>
  <div>
    <h3>Заявка на {{ mat_order }}</h3>
    {{ m.lead_form(cfg, subject) }}
  </div>
  </div>
</div></section>

<section><div class="wrap">
  <h2 id="faq">Частые вопросы</h2>
  {{ m.faq(faq) }}
</div></section>

<section><div class="wrap">
  {{ m.crossshelf(cross, "Вас также может заинтересовать") }}
</div></section>

<section><div class="wrap">
  {{ m.related(related_links) }}
</div></section>
{% endblock %}
