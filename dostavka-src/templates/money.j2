{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{# Товарная страница. Путь покупателя короткий: первый экран с ценой,
   цены и готовые объёмы, калькулятор, форма заявки. Всё остальное ниже:
   фото доставок, гарантии, почему мы, как заказать, оплата и зоны,
   машины, справочная часть (под задачу, виды, фракции, характеристики,
   расчёты), «проще написать», частые вопросы и перекрёстные ссылки.
   Справочная часть осталась целиком: её читают те, кто выбирает
   материал, и по ней страница ранжируется. #}
{% block fleet %}{% endblock %}
{% block body %}
{{ m.hero2(h1, hero_sub, bg=hero_img, bg_alt=(hero_cap ~ ", фотография материала") if hero_cap else None,
           price=hero_price, note="Оплата после выгрузки, объём проверяете по паспорту кузова", cfg=cfg, third_href=("#kalkulyator" if calc else "#zayavka"), third_text=("Посчитать в калькуляторе" if calc else "Узнать цену с доставкой")) }}

{% if quick %}
<nav class="d-quick" aria-label="Частые запросы"><div class="wrap">
  <span class="d-quick-lab">Чаще всего ищут</span>
{% for label, href in quick %}  <a href="{{ href }}">{{ label }}</a>
{% endfor %}</div></nav>
{% endif %}

{# Наверху только свой материал: на странице щебня витрина всех
   материалов занимала полторы тысячи пикселей телефона, и до
   калькулятора надо было пролистать песок, ПГС и скалу. Остальные
   строки витрины стоят ниже формы как перекрёстная продажа. #}
{% set own_rows = shelf_rows|selectattr("own")|list if shelf_rows else [] %}
{% set top_rows = own_rows if own_rows else shelf_rows %}
{% set other_rows = shelf_rows|rejectattr("own")|list if own_rows else [] %}
<section class="d-band"><div class="wrap">
{% if shelf_rows %}
  {{ m.shelf(top_rows, "Цены на " ~ mat_vin ~ " с доставкой", price_note) }}
{% elif price_rows %}
  {{ m.sh("Цены на " ~ mat_vin ~ " с доставкой", "ceny") }}
  <div class="d-table-wrap"><table>
    <caption>Цены и наличие</caption>
    <thead><tr><th>{{ price_col1|default("Позиция", true) }}</th><th>{{ price_col2|default("Цена, руб", true) }}</th></tr></thead>
    <tbody>
{% for name, price in price_rows %}      <tr><td>{{ name }}</td><td class="d-spec-val">{{ price }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
{% if price_note %}  <p class="d-note">{{ price_note }}</p>
{% endif %}{% endif %}
  <p class="d-note">{{ delivery_note }}</p>
{# Готовые объёмы карточками: фиксированная цена машины по Екатеринбургу. #}
{% if lots %}
  <h2 class="d-sh d-sh-sub" id="obemy">{{ lots_head }}</h2>
  <div class="d-lotcards">
{% for vol, p1, p2, note in lots %}    <div class="d-lotcard">
      <span class="d-lotcard-vol">{{ vol }}</span>
      <b>{{ p1 }} <small>руб</small></b>
      <span>20-40, 40-70, 70-120 с доставкой по Екатеринбургу; 5-20 за {{ p2 }} руб. {{ note }}.</span>
    </div>
{% endfor %}  </div>
  <p class="d-note">{{ lots_note }}</p>
{% endif %}
</div></section>

{% if calc %}<section class="d-band d-band-tint"><div class="wrap">
{{ m.calculator(cfg, calc, lots) }}
</div></section>
{% endif %}

{{ m.form_band(cfg, "Заявка на " ~ mat_order, subject) }}

{{ m.deliveries(fleet_photos) }}

{{ m.guarantee_band(g.guarantees, g.trust) }}

{{ m.why_band(g.why, g.stats, cfg) }}

{{ m.steps_band("Как заказать " ~ mat_order, [
    "Скажите вид материала и объём в кубах. Если объём неизвестен, назовите размеры участка работ и толщину слоя.",
    "Назовите адрес и опишите заезд: ширина ворот, место для разворота и подъёма кузова.",
    "Получите точную цену с доставкой. " ~ cfg.callback_promise|capitalize ~ ".",
    "Принимаете машину на объекте и проверяете объём. " ~ cfg.payment]) }}

{% if other_rows or quarries %}<section class="d-band d-band-tint"><div class="wrap">
{% if quarries %}
  <h2 class="d-sh" id="karyery">{{ quarries_head }}</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ quarries_note }}</caption>
    <thead><tr><th>Карьер</th><th>Вид</th><th>Цена</th><th>Чем отличается</th></tr></thead>
    <tbody>
{% for pit, kind, price, unit, note in quarries %}      <tr><td>{{ pit }}</td><td>{{ kind }}</td><td class="d-spec-val">{{ price }}{% if unit %} <span class="d-unit">{{ unit }}</span>{% endif %}</td><td>{{ note }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}
{% if other_rows %}  {{ m.sh("Другие материалы с доставкой", "drugie-materialy", "Цена за куб на площадке, доставка считается так же, по плечу от ближайшей площадки отгрузки.") }}
  {{ m.shelf(other_rows) }}
{% endif %}</div></section>
{% endif %}

{# Оплата и зоны: снимают «а вдруг предоплата» и «а ко мне поедут». #}
<section class="d-band"><div class="wrap">
  {{ m.sh("Как можно заплатить", "oplata") }}
  {{ m.payways(payment) }}
  {{ m.zones(zones, "Куда возим " ~ mat_vin,
     "Плечо доставки считается от ближайшей нашей площадки, в Екатеринбурге или в Верхней Пышме, и заметно влияет на цену за куб: чем дальше, тем выгоднее брать больший объём за одну машину. Города со ссылками имеют свою страницу с условиями.") }}
{% if mat_cities %}  {{ m.chips(mat_cities, "Доставка " ~ mat_rod ~ " по городам", "goroda", sub=True) }}
{% endif %}</div></section>

{{ m.trucks(trucks) }}

<section class="d-band"><div class="wrap d-prose">
{% if tasks %}
  {# mat_vin, а не выдуманный mat_name: в контексте товарной страницы
     название материала лежит в падежных формах, именительного отдельно
     нет. Для «щебень под задачу» винительный совпадает с именительным.
     default со вторым аргументом true: сборка передаёт tasks_head=None
     для материалов без своего заголовка, а односложный default ловит
     только необъявленную переменную и пропустил бы None в разметку. #}
  <h2 class="d-sh" id="pod-zadachu">{{ tasks_head|default(mat_vin|capitalize ~ " под задачу", true) }}</h2>
  <div class="d-tasks">
{% for head, frac, text, href, link_text in tasks %}    <div class="d-task">
      <h3>{{ head }}</h3>
      <p class="d-task-frac">{{ frac }}</p>
      <p>{{ text }}</p>
{% if href %}      <p><a href="{{ href }}">{{ link_text }}</a></p>
{% endif %}    </div>
{% endfor %}  </div>
{% endif %}

  <p>{{ intro }}</p>

{{ m.photos(photos, "Как выглядит " ~ mat_vin,
   "Снимки по каждому виду и фракции: по ним видно и цвет породы, и форму зерна, и реальный размер камня относительно рулетки или монеты.") }}

  <h2 class="d-sh" id="vidy">{{ types_head|default("Виды " ~ mat_rod) }}</h2>
  <div class="d-grid">
{% for t,d in types %}    <div class="d-card"><strong>{{ t }}</strong><p>{{ d }}</p></div>
{% endfor %}  </div>
{% if fractions %}
  <h2 class="d-sh" id="frakcii">{{ fractions_head|default("Фракции и применение", true) }}</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ fractions_caption|default("Какая фракция " ~ mat_rod ~ " под какую задачу", true) }}</caption>
    <thead><tr><th>{{ fractions_col1|default("Фракция", true) }}</th><th>{{ fractions_col2|default("Где применяют", true) }}</th></tr></thead>
    <tbody>
{% for f,use in fractions %}      <tr><td>{% if frac_href and frac_href.get(f) %}<a href="{{ frac_href[f] }}">{{ f }}</a>{% else %}{{ f }}{% endif %}</td><td>{{ use }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}
{# Фасовка. Отдельный блок, потому что вопрос «а можно в мешках»
   возникает раньше вопроса о фракции: от ответа зависит, поедет
   ли машина вообще. Цены тут нет намеренно - фасовка считается
   по заявке, а выдуманная цифра хуже отсутствующей. #}
{% if packs %}
  <h2 class="d-sh" id="fasovka">{{ packs_head|default("Фасовка и объём", true) }}</h2>
  <div class="d-table-wrap"><table>
    <caption>Как берут материал и сколько выходит в кубе</caption>
    <thead><tr><th>Фасовка</th><th>Объём</th><th>Цена</th><th>Когда её берут</th></tr></thead>
    <tbody>
{% for pack, vol, price, when in packs %}      <tr><td>{{ pack }}</td><td class="d-spec-val">{{ vol }}</td><td class="d-spec-val">{{ price }}</td><td>{{ when }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}
{# Числовые характеристики материала. У конкурентов на этом рынке
   в товарных карточках обычно стоит только строчка «соответствует ГОСТ»
   без единой цифры, хотя по этим числам считают объём и выбирают
   материал под нагрузку.

   Третья колонка обязательна: голое «1,10-1,30» ничего не говорит,
   а «на 10 кубов слоя заказывают 11-13» говорит всё. Числа взяты
   из наших же статей и обязаны с ними совпадать. #}
{% if specs %}
  <h2 class="d-sh" id="harakteristiki">{{ specs_head|default("Характеристики " ~ mat_rod, true) }}</h2>
  <div class="d-table-wrap"><table>
    <caption>Числа, по которым считают объём и выбирают материал под нагрузку</caption>
    <thead><tr><th>Параметр</th><th>Значение</th><th>Что это значит на объекте</th></tr></thead>
    <tbody>
{% for param, val, note in specs %}      <tr><td>{{ param }}</td><td class="d-spec-val">{{ val }}</td><td>{{ note }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
{% endif %}
  <h2 class="d-sh" id="skolko">{{ calc_head|default("Сколько нужно на типовые задачи") }}</h2>
  <div class="d-table-wrap"><table>
    <caption>{{ own_calc_caption or calc_caption|default("Готовые расчёты с запасом на уплотнение, чтобы прикинуть объём до заявки") }}</caption>
    <thead><tr><th>{{ calc_col1|default("Задача") }}</th><th>{{ calc_col2|default("Объём с запасом") }}</th><th>{{ calc_col3|default("Машина") }}</th></tr></thead>
    <tbody>
{% for task,vol,car in (own_calc_rows or calc_rows) %}      <tr><td>{{ task }}</td><td>{{ vol }}</td><td>{{ car }}</td></tr>
{% endfor %}    </tbody>
  </table></div>
  <p class="d-note">Расчёт ориентировочный: точный объём зависит от толщины слоя и плотности грунта. Посчитаем под ваш объект по размерам.</p>
</div></section>

{{ m.msg_card(cfg) }}

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.sh("Частые вопросы", "faq") }}
  {{ m.faq(faq) }}
</div></section>

<section class="d-band"><div class="wrap">
  {{ m.crossshelf(cross, "Вас также может заинтересовать") }}
  {{ m.chips(related_links, "Смотрите также", sub=True) }}
</div></section>
{% endblock %}
