{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{% block body %}
<section class="d-hero" style="--cell:{{ hero_cell|default(28) }}px"><div class="wrap d-hero-grid">
  <div class="d-hero-main">
  <h1>{{ h1 }}</h1>
  <p>{{ hero_sub }}</p>
  {{ m.channels(cfg, "#zayavka", "Рассчитать заявку") }}
  </div>
  {{ m.hero_panel(hero_frac|default("щебень 20-40 мм")) }}
</div></section>

<section><div class="wrap d-prose">
  <div class="d-tldr"><strong>Коротко, если некогда читать</strong><p>{{ lead }}</p></div>
  {{ m.pricebar(anchor) }}

  <h2 id="skolko-stoit">{{ items_head }}</h2>
</div></section>

{# Список рубрики. Каждая карточка это отдельная посадочная страница
   под свой параметр: клиент ищет «кольца для колодца», а не «ЖБИ». #}
<section><div class="wrap">
  <div class="d-cat">
{% for it in items %}    <div class="d-cat-card">
      <p class="d-cat-name"><a href="{{ it.href }}">{{ it.name }}</a></p>
      <p class="d-cat-price">{{ it.price }}{% if it.unit %} <small>{{ it.unit }}</small>{% endif %}</p>
      <p>{{ it.desc }}</p>
      <p class="d-cat-go">Подробнее и заказать</p>
    </div>
{% endfor %}  </div>
  <p class="d-note">{{ price_note }}</p>
</div></section>

<section><div class="wrap d-prose">
{% for s in sections %}
  <h2 id="{{ s.id }}">{{ s.h }}</h2>
{{ m.blocks(s) }}
{% if loop.index == cta_after %}{{ m.midcta(cfg, cta_head, cta_text) }}{% endif %}
{% endfor %}
</div></section>

{% if photos %}<section><div class="wrap d-prose">
  {{ m.photos(photos, photos_head, photos_intro) }}
</div></section>
{% endif %}

<section id="zayavka"><div class="wrap">
  <h2>Оставить заявку</h2>
  <div class="d-two">
  <div>{{ m.callblock(cfg) }}</div>
  <div>
    <h3>{{ form_head }}</h3>
    {{ m.lead_form(cfg, subject) }}
  </div>
  </div>
</div></section>

<section class="d-dark-sec"><div class="wrap">
  {{ m.objections(objections, None,
     "Самосвалы от 5 до 20 кубов и манипулятор под штучный товар по " ~ cfg.region_dat ~ ". Разгрузка на объекте, оплата после выгрузки, " ~ cfg.callback_promise ~ ".") }}
</div></section>

<section><div class="wrap">
  <h2>Частые вопросы</h2>
  {{ m.faq(faq) }}
</div></section>

<section><div class="wrap">
  {{ m.related(related_links) }}
</div></section>
{% endblock %}
