{% extends "base.j2" %}
{% import "_macros.j2" as m %}
{# Рубрика (ЖБИ, благоустройство) по образцу владельца: цены карточками,
   фото доставок, быстрая заявка, гарантии, почему мы, форма, текст. #}
{% block fleet %}{% endblock %}
{% block body %}
{{ m.hero2(h1, hero_sub, bg=hero_img, bg_alt=(hero_cap ~ ", фотография") if hero_cap else None, cfg=cfg, third_href=("#kalkulyator" if calc else "#zayavka"), third_text=("Посчитать в калькуляторе" if calc else "Узнать цену с доставкой")) }}

<section class="d-band"><div class="wrap">
  <div class="d-tldr"><strong>Коротко, если некогда читать</strong><p>{{ lead }}</p></div>
  {{ m.pricebar(anchor) }}
  {{ m.sh(items_head, "skolko-stoit", sub=True) }}
  <div class="d-cat">
{% for it in items %}    <div class="d-cat-card">
      <p class="d-cat-name"><a href="{{ it.href }}">{{ it.name }}</a></p>
      <p class="d-cat-price">{{ it.price }}{% if it.unit %} <small>{{ it.unit }}</small>{% endif %}</p>
      <p>{{ it.desc }}</p>
      <p class="d-cat-go">Подробнее и заказать</p>
    </div>
{% endfor %}  </div>
  <p class="d-note">{{ price_note }}</p>
</div></section>

{{ m.form_band(cfg, form_head, subject) }}

{{ m.deliveries(fleet_photos) }}

{{ m.guarantee_band(g.guarantees, g.trust) }}

{{ m.why_band(g.why, g.stats, cfg) }}

{{ m.trucks(trucks) }}

<section class="d-band"><div class="wrap d-prose">
{% for s in sections %}
  <h2 class="d-sh" id="{{ s.id }}">{{ s.h }}</h2>
{{ m.blocks(s) }}
{% endfor %}
{% if photos %}  {{ m.photos(photos, photos_head, photos_intro) }}
{% endif %}</div></section>

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.objections(objections, None,
     "Самосвалы от 5 до 20 кубов и манипулятор под штучный товар по " ~ cfg.region_dat ~ ". Разгрузка на объекте, оплата после выгрузки, " ~ cfg.callback_promise ~ ".") }}
</div></section>

{{ m.msg_card(cfg) }}

<section class="d-band"><div class="wrap">
  {{ m.sh("Частые вопросы", "faq") }}
  {{ m.faq(faq) }}
</div></section>

<section class="d-band d-band-tint"><div class="wrap">
  {{ m.chips(related_links, "Смотрите также") }}
</div></section>
{% endblock %}
